		)
		(uuid "c4d19901-b40a-5292-a6e1-e0b1241ee01d")
	)
	(text "IREF and VSL networks"
		(exclude_from_sim no)
		(at 349.25 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
