		(uuid "aada34d8-9e9e-520d-80c5-ea79428023ea")
	)
	(text "Boost input: load switch VSYS -> OLED_VIN, CIN, inductor"
		(exclude_from_sim no)
		(at 15.24 162.56 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "73b580d2-0d3a-5119-97fd-d5de44a71392")
	)
	(text "OLED_VCC_EN low (also through MCU reset, R25) -> U21 off: VCC floats, boost draws 0 uA.                                                                                             \nWithout it a disabled boost still passes VSYS - Vf to VCC through L20 and D21.\nU21 TPS22917: CT 1 nF from CT to VIN (C37) -> ~4 ms ramp. Inrush is set by the TPS61040 soft start\n(it starts at its 1.5 V UVLO while U21 ramps): ~0.3 A for ~2 ms, 0.4 A peak.\nQOD tied to OLED_VIN: when off, OLED_VIN is held at ~0 V (150 R) so the boost (EN = VIN) stays off;\notherwise D21 leakage from the panel's VCI->VCC ESD path floats it up and the boost hiccups in sleep.\n(Replaces the AO3401A/2N7002 disconnect, which had no real dV/dt control - review SCH-1.)\nLAYOUT: L20 and the SW node >= 10 mm from the TMAG5273 and the magnet track."
		(exclude_from_sim no)
		(at 15.24 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "cf311cfa-8337-539b-9c7f-962c07ed139c")
	)
	(rectangle
		(start 12.7 160.02)
		(end 198.12 267.97)
		(stroke
