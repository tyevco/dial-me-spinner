	(text "OLED ZIF J20: NHD-1.5-128128G panel, 30-pin 0.5 mm FPC"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "dc5d0a75-d570-586f-8dea-8874cfd6b99c")
	)
	(text "Pin map from Newhaven NHD-1.5-128128G datasheet, Pin Description + Interface Selection (p.4), Wiring Diagram (p.5):                 \n  https://newhavendisplay.com/content/specs/NHD-1.5-128128G.pdf   (Orient AOC128128A0-1.50W is pin-identical)\n1 NC(GND)=GND | 2 VCC=+13V_OLED | 3 VCOMH | 4 VDDIO=+3V3 | 5 VSL | 6 NC | 7-11 D7..D3=GND\n12 D2 open (SPI) | 13 D1=SDIN | 14 D0=SCLK | 15 E/RD#=GND | 16 R/W#=GND | 17 BS0=GND | 18 BS1=GND\n19 CS# | 20 D/C# | 21 RES# | 22 IREF | 23 GPIO1, 24 GPIO0, 25 NC: open | 26 VDD (int. reg.)\n27 VCI=+3V3 | 28 VSS | 29 NC | 30 NC(GND)=GND.   BS1:BS0 = 00 -> 4-wire SPI, write-only, mode 0, <= 20 MHz.\nBottom-contact ZIF: FPC folds 180 deg behind the glass (NHD's top-contact advice is for unfolded entry).\nRES# 1M pull-down keeps the panel in reset while the MCU is in reset. Mates with the panel (not assembled).\nFPC fit: NHD W 15.5+/-0.2 / t 0.3+/-0.03 / stiffener 4+/-0.5 vs JUSHUO slot 15.60+/-0.05, recommended FPC\n  15.50+/-0.05 / t 0.30+/-0.01 / stiffener 6.0: check insertion, latch and retention with real panel samples\n  (with the 1:1 contact-side mock-up) before PCBA."
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "6b847aae-90e8-5c43-acd1-a1de1967b8e8")
	)
	(rectangle
		(start 12.7 17.78)
		(end 149.86 154.94)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "91c4d99b-c5d2-5847-8c51-382db7f9c4f4")
	)
	(text "Panel supply capacitors (at the ZIF pins)"
		(exclude_from_sim no)
		(at 157.48 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a7135f76-405d-5483-97a9-e366b4a5fa66")
	)
	(text "NHD wiring diagram: VCC C5 0.1u + C6 10u (C31, C30), VCOMH C7 4.7u/25V tantalum (C32),                                                                                                \nVDDIO C3 1u (C33), VDD C4 1u (C34), VCI C1 0.1u + C2 4.7u (C36, C35).\nC39 = boost output cap on +13V_OLED: place it at D21 / U20 GND, not at the ZIF.\nNo bleeders or QOD switches on +3V3 / +13V_OLED (VCC must float when off)."
		(exclude_from_sim no)
		(at 157.48 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "faa174ce-e1d1-510d-ae5d-dbe320582080")
	)
