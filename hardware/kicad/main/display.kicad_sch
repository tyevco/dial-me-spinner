		(uuid "fb1f4205-d7fe-5f75-84c4-a0df7b08c045")
	)
	(text "IREF: R = (VCC - 6 V) / 12.5 uA = 560k at 13 V (recompute if VCC changes).\nVSL: 50 ohm 1/4 W + ~1.4 V: BAV99 as 2 series diodes (pin 1 A1, pin 3 mid NC, pin 2 K2)."
		(exclude_from_sim no)
		(at 349.25 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "63d65ee8-ace8-54e4-9869-d9f37a76119d")
	)
