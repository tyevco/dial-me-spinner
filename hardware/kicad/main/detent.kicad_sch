	)
	(text "DRV5032FA omnipolar push-pull, always on\n(+3V3, 1.6 uA typ avg). HOME_N low = detent\nmagnet parked (free mode); no pull-up needed\nTOP side only, above park pos. r 21.5, theta 90\n(bottom = keep-out, 0.5 mm to the magnet)"
		(exclude_from_sim no)
		(at 15.24 100.33 0)
		(effects
