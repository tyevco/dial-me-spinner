	(text "Coil A driver - DRV8837 #1"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "abaf7482-70c7-53c0-a6f0-671d312e37f5")
	)
	(text "IN1/IN2: 00 coast, 10 fwd, 01 rev, 11 brake\nVM = VSYS (3.0-4.5 V), VCC = +3V3\nPin 4 + EP (pad 9) to the GND plane\n100 nF at the VM pin and at the VCC pin\nU40/U41 + caps: TOP side in theta 60-120, or\nBOTTOM only outside theta 60-120 (keep-out)"
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "2ce25353-f650-5102-a589-2fb2c84f9f1e")
	)
	(rectangle
		(start 12.7 17.78)
		(end 115.57 88.9)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "d2a93cdf-3cb5-57e1-baca-40ae67477968")
	)
	(text "Coil B driver - DRV8837 #2"
		(exclude_from_sim no)
		(at 123.19 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c963bd4a-28d9-5515-a670-e8fd8965d5dc")
	)
	(text "Same as #1. A 2-wire DC gearmotor uses\ncoil A only (U40, J40 pins 1-2); U41 then\nidles with IN1/IN2 low"
		(exclude_from_sim no)
		(at 123.19 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "3be241ab-78e6-5afe-adf3-f05a5f212861")
	)
	(rectangle
		(start 120.65 17.78)
		(end 224.79 81.28)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "6d6847f7-77f1-5cf3-9f29-f276eabb3f1c")
	)
	(text "Shared VM bulk + nSLEEP pull-down"
		(exclude_from_sim no)
		(at 232.41 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "467e368a-95ce-5edf-a1af-1d63ee419a88")
	)
	(text "10 uF/25 V 0805 placed between the two VM pins\nnSLEEP: 100k ext. pull-down (SPEC §4) in\nparallel with the 100k internal one in each DRV\nSleep: IVM+IVCC <= 2x(95+25) nA = 0.24 uA max"
		(exclude_from_sim no)
		(at 232.41 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "34232352-d411-5602-a986-583e51989042")
	)
	(rectangle
		(start 229.87 17.78)
		(end 292.1 71.12)
		(stroke
