	)
	(text "Side entry SM04B, ~2.9 mm tall: the lead\nruns in-plane to the radial actuator\nBottom side: just outside the theta 60-120\nkeep-out, r < 27, entry facing the actuator\n1 A+, 2 A-, 3 B+, 4 B-\n2-wire DC gearmotor: pins 1-2 only\nMP solder tabs to GND"
		(exclude_from_sim no)
		(at 299.72 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "061d81ed-ba06-50f7-b5c6-3f80c9527cbf")
