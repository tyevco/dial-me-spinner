	(text "USB VBUS (module pad 32) and second-stage USB ESD"
		(exclude_from_sim no)
		(at 140.97 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "54e60d5f-5642-5fe9-a580-f9161b3f4617")
	)
	(text "R12 in series (nRF52840 PS 7.3 config 1): a legacy-cable hot plug rings the link VBUS to 6.5-8.4 V,\nabove the 5.8 V VBUS abs max; with 4.7 R (Nordic's value) R12 x C12 filters the ring and the pin sees the settled\nVBUS, 4.49-5.49 V for a 4.5-5.5 V source (hardware/sim test_hotplug_nrf_vbus_abs_max).\nDC drop ~11 mV at the 2.4 mA VBUS current. C12 on the module side; total sink C < 10 uF.\nU12 USBLC6 at the module: IEC 8 kV on D+/D- otherwise drives 2.6-3.7 A into the nRF pads through the\n~145 nH link (HBM 2 kV class = 1.33 A). U12 as close as the module courtyard allows (3.5 mm pad to\npad to D-); test_usb_input reads the placed distance."
		(exclude_from_sim no)
		(at 140.97 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "5ef17cc2-5a00-5001-a3f2-f84035688acb")
	)
	(rectangle
		(start 138.43 17.78)
		(end 256.54 87.63)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "183bd949-e8d5-5d10-a072-4e652b9f8502")
	)
	(text "32.768 kHz LFXO"
		(exclude_from_sim no)
		(at 264.16 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ce9721bc-14aa-5845-ad85-cec1bed85b0f")
	)
	(text "SC-20S CL 9 pF; Ccap = 2*CL - Cpin - Cpcb ~ 12 pF C0G.\nR1 <= 90k (nRF RS_LFXO max 100k); DLmax 0.5 uW = nRF PD_LFXO.\nAt pads 17/18, traces < 5 mm, symmetric, GND guard; no copper under Y1."
		(exclude_from_sim no)
		(at 264.16 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "c35557be-313b-5abd-9f7a-afc5f8b29e62")
	)
