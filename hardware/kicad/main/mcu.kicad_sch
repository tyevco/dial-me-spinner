	)
	(text "Coil between NFC1 and NFC2: its flex tail solders to pads J11 (coil in the top cover).\nTune: Ctune = 2/((2*pi*13.56 MHz)^2 * L_coil) - Cp - Cint (Cint ~ 4 pF, PS 6.13);\n180 pF C0G each suits L ~ 1.4-1.5 uH; retune on prototype.\nRoute NFC1/NFC2 as a pair, away from the TMAG and the LED data line."
		(exclude_from_sim no)
		(at 199.39 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "8dd95369-a1d2-5244-abe7-f6aa511fe2ad")
	)
