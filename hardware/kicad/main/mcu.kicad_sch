	(text "QSPI NOR flash (128 Mbit)"
		(exclude_from_sim no)
		(at 15.24 162.56 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "06e3db0f-2aa1-55e0-b958-4ba35c8b5a73")
	)
	(text "nRF52840-DK QSPI pins (pads 41-46); traces < 20 mm, matched within 2 mm.\n-IQ suffix: QE=1 fixed, /WP and /HOLD disabled, so IO2/IO3 need no pull-ups.\nCS pulled up so the flash stays deselected in reset. Use deep power-down when idle."
		(exclude_from_sim no)
		(at 15.24 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d60d3e09-63e2-57b1-9c86-dd30d5f257bf")
	)
