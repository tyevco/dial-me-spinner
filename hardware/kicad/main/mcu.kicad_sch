	(text "nRF52840 module MDBT50Q-U1MV2"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "89948e40-3bfe-56de-a30a-c90ec5dc3e9b")
	)
	(text "Normal-voltage mode: VDD + VDDH on +3V3, DCCH n/c,\nREG1 DC/DC on (its inductor is inside the module).\nu.FL on module -> Molex 146153-0100 flex antenna.\nPin map = nets.MCU_PINS (SPEC §4).\nUICR: P0.18 = nRESET; NFCPINS stays in NFC mode\n(P0.09/P0.10 = NFC1/NFC2 antenna).\nSymbol: stock MDBT50Q-U1MV2 pins, regrouped by port."
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "4f701b46-74ee-5499-a019-53d41393d663")
	)
	(rectangle
		(start 12.7 17.78)
		(end 77.47 154.94)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "898759d2-51aa-58b6-89f8-3c5e229c6d12")
	)
