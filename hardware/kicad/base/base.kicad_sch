	(text "USB-C input and protection"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "49c7e776-86b5-5f5c-a8af-4db6f7845bb9")
	)
	(text "HRO TYPE-C-31-M-12 (sink, USB 2.0). Separate 5.1k Rd per CC pin; D+/D- pairs tied at the connector.\nUSBLC6-2SC6 and SMF5.0A within 5 mm of J1; route D+/D- through the ESD pads (flow-through) as a 90R pair.\nJ1 body (3.26 mm tall, 7.35 mm deep) reaches r ~27.6, under the FA lower plate (r <= 30): plate needs a relief there."
		(exclude_from_sim no)
		(at 15.24 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "1a7476bd-c97c-56cd-a498-1cca182ce1ec")
	)
	(rectangle
		(start 12.7 17.78)
		(end 186.69 97.79)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "8414dce2-71d9-5aff-9e76-a403d5560b38")
	)
	(text "Charger and power path (BQ25180, I2C 0x6A)"
		(exclude_from_sim no)
		(at 194.31 20.32 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7fbe3fb3-dd35-55ea-9ed1-d6fbec9d893e")
	)
	(text "IN 2.2u/25V, SYS 10u/25V, BAT 4.7u: each within 1 mm of its ball and of the D2 GND ball.\nSYS = VSYS (4.5 V on USB, VBAT on battery). /INT, SCL, SDA pull-ups are on the main board."
		(exclude_from_sim no)
		(at 194.31 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "d54c7e38-4417-53ec-bcfc-2d8bfd55bbfa")
	)
	(rectangle
		(start 191.77 17.78)
		(end 342.9 80.01)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "7138b039-bf0e-54f2-905f-381da6d5dad4")
	)
	(text "Battery connector J2 and NTC RT1 (TS/MR)"
		(exclude_from_sim no)
		(at 15.24 105.41 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "c35fb451-d1db-5c51-98a7-7e366a958c04")
	)
	(text "J2 pin 1 = BAT+, pin 2 = GND. PH lead polarity varies by vendor:\ncheck every pack! J2 (~5.5 mm tall) needs a lower-plate cut-out.\nRT1 on TS/MR: top side, at the board edge farthest from U1\n(>= 10 mm), no copper shared with U1. Bottom side has no parts,\nso RT1 reads board temperature, not the cell. GND Kelvin to D2.\nNo cap on TS/MR (TS bias is pulsed 4 ms / 196 ms)."
		(exclude_from_sim no)
		(at 15.24 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "49ff8d64-cdc1-548d-8e1f-0f69ab21eca0")
	)
	(rectangle
		(start 12.7 102.87)
		(end 87.63 163.83)
		(stroke
			(width 0.1)
			(type dash)
		)
		(fill
			(type none)
		)
		(uuid "dfe09ef8-dd19-58ca-9630-559f1386c5bd")
	)
	(text "Centre press switch and ship-mode wake"
		(exclude_from_sim no)
		(at 95.25 105.41 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0d8222e8-5018-5fda-9256-727e0a89b7d0")
	)
	(text "SW1 at the board centre (top). Press: VBAT -> 1k -> SW1 -> SW_GATE (1M to GND, ~4 uA while held).\nQ1A pulls TS/MR low (ship wake / 20 s HW reset); Q1B pulls BTN_N low (nRF SENSE wake). BTN_N pull-up is on main."
		(exclude_from_sim no)
		(at 95.25 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "0358dbb2-d863-5b3c-ba6b-d846fb070896")
	)
