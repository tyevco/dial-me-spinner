// =====================================================================
//  dial-me-spinner rev A  --  parametric mechanical model (OpenSCAD 2021.01)
// =====================================================================
//  Follows hardware/design/SPEC.md section 8 (stack-up).  Frame:
//    z = 0 is the desk, z up.  theta = 0 deg is the USB-C direction (+X),
//    angles increase counter-clockwise seen from +Z.  Units: mm.
//  Every SPEC number is a named constant.  Where SPEC cannot be built as written the
//  constant is tagged "DEV:" and docs/mechanical.md section 3 (or the section named in the
//  tag) explains why.  Where SPEC is silent and the value is chosen here, it is tagged "TVP:"
//  (to verify on prototype).
//  Board components come from the real KiCad layouts (board_parts.scad, generated by
//  extract_board_parts.py), so the clash checks test the current PCB placement.
//
//  Views  (-D 'view="..."'):
//    assembly      full device
//    section       cut on the YZ plane (x = 0): detent carriage, TMAG, antenna, battery
//    section_xz    cut on the XZ plane (y = 0): USB-C, theta-180 guide, spindle stack
//    exploded      exploded along Z (scale with -D explode=1)
//    board_bottom  main board + everything hanging under it, seen from below
//    base_top      base board, battery, antenna, cup, seen from above (FA removed)
//    clash         interference geometry (red) on the board underside, rotor ghosted
//    clash_geom    geometry only (use with -o x.stl; empty result = no clash), see check_clashes.sh
//    nfc           cut along the J11 axis (theta 222): NFC coil, tail, J11 joint, bracket relief, glass, cover
//    prims         echo the analytic primitives that calcs.py uses for per-part clearances
//    part          one printable part, on the bed, for STL export (-D 'part="base_cup"')
//
//  Other switches: det_offset (0 = click .. 7.5 = free spin), press (0..1),
//  clash_margin, show_knurl, show_board_parts.
// =====================================================================
include <board_parts.scad>

/* [View] */
view = "assembly";
part = "base_cup";
det_offset = 0.0;       // detent carriage radial offset, mm (0 = full click .. 7.5 = free)
press = 0.0;            // 0..1, fraction of STOP_TRAVEL the floating assembly is pushed down
explode = 1.0;
clash_margin = 0.0;     // grow the rotor envelope by this (mm) in the clash check
clash_mode = "rotor";   // clash_geom: "rotor", "press", "rest", "pair"
clash_item = -1;        // clash_geom: index into STATIONARY_NAMES
clash_b = -1;           // clash_geom, mode "pair": second index
show_knurl = true;
show_board_parts = true;
fn_big = 144;
fn_mid = 64;
fn_small = 24;

