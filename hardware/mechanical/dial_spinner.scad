ROT_HUB_TOP = CAP_Z[1];             // 26.0 = SPEC section 8 rotating hub top (doc section 3 A6)
// SPEC section 8 main-board bottom rules (drawn by spec_keepout_overlay in the board_bottom view)
KO_SECTOR   = [60, 120];            // no bottom components, r 12-32 (actuator and detent carriage)
KO_R        = [12, 32];
CORRIDOR_A  = [30, 160];            // actuator corridor: bottom parts <= 1.3 mm tall (bottom z >= 27.8)
CORRIDOR_R  = [8.5, 27];
CORRIDOR_H  = 1.3;
HUB_ZONE_R  = [9.5, 12.5];          // rotating hub zone: bottom parts keep their bottom at z >= 26.3
HUB_ZONE_Z  = 26.3;
// 608 bearing z 18.0-25.0
B_D         = 22.0;
B_d         = 8.0;
B_Z0        = 18.0;
B_Z1        = 25.0;
// stationary spacers / hub (brass)
LS_RO       = 5.75;
LS_FL_RO    = 10.6;
LS_FL_Z1    = CW_Z0 - 0.15;         // 16.85: 0.15 drop-stop gap under the carrier lip
LS_FL_Z0    = 16.40;
HUB_FL_Z0   = 26.1;
HUB_FL_RO   = 8.5;                  // SPEC bottom keep-out r <= 8.5
HUB_SCREW_R = 6.5;
HUB_SCREW_A = [90, 210, 330];       // as placed on the main PCB (H1-H3)
// main board Ø64, z 29.1-30.7
MB_Z0       = 29.1;
MB_T        = 1.6;
MB_Z1       = MB_Z0 + MB_T;
MB_R        = 32.0;
MB_BRK_R    = 17.0;
MB_BRK_A    = [60, 120];
// detent: N52 Ø3x2, 1.0 above the track, r 29.0 (click) -> 21.5 (free) along theta 90
DET_D       = 3.0;
DET_H       = 2.0;
DET_GAP     = 1.0;
DET_R_CLICK = 29.0;
DET_STROKE  = 7.5;
DET_Z0      = RING_Z1 + DET_GAP;    // 26.6
CARR_T      = 0.48;                 // DEV: SPEC carriage plate 0.5; 0.48 in a 0.50 rail gap: <= 0.02 capture (shimmed), doc section 7
RAIL_X      = [3.05, 3.65];         // rail upright inner/outer x (0.05 side clearance)
RAIL_Y      = [18.6, 31.6];
