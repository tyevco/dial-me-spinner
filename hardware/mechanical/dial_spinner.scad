NUT_OD      = 7.0;
NUT_H       = 1.5;
FLAT_DEPTH  = 0.3;                  // D-flats (plate, spacer, hub) at theta 90
// rotor ring 316L OD 70 / ID 54, z 15.6-25.6, track on the TOP face
RING_RO     = 35.0;
