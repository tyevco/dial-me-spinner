STATIONARY_NAMES = ["base_cup", "base_board", "base_parts", "battery", "battery_leads", "antenna", "guide_pins",
                    "fa_lower_plate", "spindle+pad", "lower_spacer", "hub+nut", "main_board", "main_bottom_parts",
                    "main_top_parts", "detent@click", "detent@free", "light_box", "oled_bracket", "oled_glass",
                    "top_cover", "harness", "coax", "nfc_coil", "nfc_tail"];
module stationary_item(i) {
    if (i == 0) base_cup();
    else if (i == 1) base_board_pcb();
    else if (i == 2) { base_top_parts(); base_bottom_parts(); }
    else if (i == 3) battery();
    else if (i == 4) battery_leads();
    else if (i == 5) antenna();
    else if (i == 6) guide_pins();
    else if (i == 7) fa_lower_plate();
    else if (i == 8) { spindle(); press_pad(); }
    else if (i == 9) lower_spacer();
    else if (i == 10) { spindle_hub(); hub_nut(); }
    else if (i == 11) main_board_pcb();
    else if (i == 12) main_bottom_parts();
    else if (i == 13) main_top_parts();
    else if (i == 14) detent_assembly(0);
    else if (i == 15) detent_assembly(DET_STROKE);
    else if (i == 16) light_box();
    else if (i == 17) oled_bracket();
    else if (i == 18) oled_glass();
    else if (i == 19) { top_cover(); window_lens(); diffuser(); }
    else if (i == 20) harness();
    else if (i == 21) coax();
    else if (i == 22) nfc_coil();
    else if (i == 23) nfc_tail();
}
BASE_ITEMS = [0, 1, 2, 3, 4, 5, 6];        // do not move on a press
FA_ITEMS = [7, 8, 9, 10, 11, 12, 14, 15];  // move down with the press
module clash_rotor(i) intersection() { rotor_envelope(); stationary_item(i); }
module clash_press(i, t)
    intersection() {
        stationary_item(i);
        translate([0, 0, -t]) union() { rotor_envelope(); for (j = FA_ITEMS) stationary_item(j); }
    }
module clash_pair(a, b) intersection() { stationary_item(a); stationary_item(b); }

// ---------- analytic primitives for calcs.py (view = "prims") ----------
module echo_prims() {
    echo(PRIM = ["annz", "hub_flange", SP_OD / 2, HUB_FL_RO, HUB_FL_Z0, MB_Z0]);
    echo(PRIM = ["annz", "hub_lower", SP_OD / 2, LS_RO, B_Z1, HUB_FL_Z0]);
    echo(PRIM = ["annz", "drop_stop_flange", LS_RO, LS_FL_RO, LS_FL_Z0, LS_FL_Z1]);
    echo(PRIM = ["annz", "nut", SPIGOT_D / 2, NUT_OD / 2, MB_Z1, MB_Z1 + NUT_H]);
    for (off = [0, DET_STROKE]) {
        xs = -15.0 + off * ST_STROKE / DET_STROKE;
        tag = off == 0 ? "@click" : "@free";
        echo(PRIM = ["cylx", str("stepper_can", tag), [ST_CAN_X[0], ST_Y, ST_ZA], ST_CAN_X[1] - ST_CAN_X[0], ST_CAN_D / 2]);
        echo(PRIM = ["box", str("stepper_front", tag), [ST_CAN_X[0] - 1, ST_Y - 4, ST_ZA - 4], [1, 8, 8]]);
        echo(PRIM = ["box", str("stepper_endtab", tag), [ST_SCREW_X[0] - 1, ST_Y - 2.5, ST_ZA - 4], [1, 5, 5.5]]);
        echo(PRIM = ["box", str("stepper_bar", tag), [ST_SCREW_X[0] - 1, ST_Y - 2, ST_ZA - 4], [ST_CAN_X[0] - ST_SCREW_X[0] + 1, 4, 0.5]]);
        echo(PRIM = ["cylx", str("lead_screw", tag), [ST_SCREW_X[0], ST_Y, ST_ZA], ST_SCREW_X[1] - ST_SCREW_X[0], 1.0]);
        echo(PRIM = ["box", str("slider_nut", tag), [xs - 2.5, ST_Y - 2, ST_ZA - 2], [5, 4, 4]]);
        echo(PRIM = ["box", str("saddle", tag), [7.0, ST_Y - 4.6, ST_ZA + 1.5], [3.6, 9.2, MB_Z0 - ST_ZA - 1.5]]);
        yc = DET_R_CLICK - off;
        echo(PRIM = ["box", str("carriage_plate", tag), [-2.95, yc - 2.5, DET_Z0 + 2.0], [5.9, 5.0, CARR_T]]);
        echo(PRIM = ["cylz", str("magnet_cup", tag), [0, yc, DET_Z0], 2.01, 2.0]);
        echo(PRIM = ["box", str("rails", tag), [-RAIL_X[1], RAIL_Y[0], MB_Z0 - 1.0], [2 * RAIL_X[1], RAIL_Y[1] - RAIL_Y[0], 1.0]]);
        echo(PRIM = ["chain", str("link_plate", tag), [for (q = CAR_STRIP) [q[0], yc + q[1], DET_Z0 + (LINK_Z[0] + LINK_Z[1]) / 2]], 1.5, (LINK_Z[1] - LINK_Z[0]) / 2]);
    }
    echo(PRIM = ["chain", "harness", HARN_PTS, HARN_D / 2, HARN_D / 2]);
    echo(PRIM = ["chain", "coax", COAX_PTS, 0.565, 0.565]);
    echo(PRIM = ["chain", "battery_leads", LEAD_PTS, 0.9, 0.9]);
    echo(ROTOR_CONST = [RING_RI, RING_RO, RING_Z0, RING_Z1, CH_TO, CH_BO, CH_IN, CW_Z0, CW_Z1, COLLAR_RI, COLLAR_RO,
                        COLLAR_Z1, LIP_RI, B_Z0, B_Z1, CAP_RI, WS_Z[0], CAP_Z[1]]);
    // NFC coil + tail (calcs.py section 13); tail profile in the J11 frame (v radial, z), width along u
    echo(NFC_CONST = [NFC_RI, NFC_RO, NFC_CU[0], NFC_CU[1], NFC_Z0, NFC_T, NFC_POCKET_R, OLED_Z0 + OLED_T + 0.3,
                      J11P[2], J11P[3], J11P[4], J11P[5], J11P[6], J11P[7], J11P[8], J11P[9] + J11P[10],
                      NFC_TAIL_W, NFC_TAIL_BR, NFC_TAIL_RV, NFC_TAIL_V0, NFC_TAIL_ZB, NFC_ROOT_R, NFC_TONGUE_L,
                      J11_RELIEF[0], J11_RELIEF[1], J11_RELIEF[2], J11_RELIEF[3],
                      OLED_W, OLED_L, OLED_YC, OLED_Z0, OLED_T, BRK_Z1 - BRK_RIM_T, BRK_Z1, LB_RI, LB_Z1, DIF_RI]);
    echo(NFC_TAIL_PROF = NFC_TAIL_PROF);
}

