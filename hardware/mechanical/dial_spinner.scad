ST_Y        = 15.5;
ST_ZA       = 23.8;                 // axis height (can z 19.8-27.8; slider nut top 25.8 under J40)
ST_CAN_D    = 8.0;
ST_CAN_X    = [6.5, 15.5];
ST_SCREW_X  = [-16.5, 6.5];
ST_STROKE   = 10.0;
SLOT_SLOPE  = DET_STROKE / ST_STROKE;   // 0.75
// LEDs / optics
LED_N       = 48;
LED_R       = 28.5;
LB_Z0       = 31.6;
LB_Z1       = 34.2;
LB_RI       = 27.0;
LB_RO       = 30.0;
LB_WALL     = 0.6;
SEPTA_N     = 24;
OLED_W      = 33.8;
OLED_L      = 34.0;
OLED_T      = 1.7;
OLED_Z0     = 33.0;
OLED_AA     = 26.86;
OLED_AA_OFF = 1.47;
OLED_YC     = -OLED_AA_OFF;         // glass centre (FPC edge toward theta 270)
BRK_Z1      = 32.8;                 // + 0.2 foam = glass bottom 33.0
BRK_RIM_T   = 1.0;                  // rim/spokes 31.8-32.8: parts under them must be <= 1.0 tall
COV_Z0      = 34.2;
COV_Z1      = 36.0;
COV_R       = 32.5;
WIN_D       = 30.0;
LENS_D      = 33.0;
LENS_T      = 0.7;                  // chemically strengthened cover glass, bonded in the cover
DIF_RI      = 27.0;
DIF_RO      = 30.0;
// NFC tag coil (SPEC sections 1/5.2/8): 13.56 MHz flex coil in the top cover (~1.4-1.5 uH for C16/C17 180 pF), tail
// soldered to the flat pads J11 on the main-board top (r 21.5, theta 222, under the glass and the bracket rim).
// SPEC gives no coil geometry: everything below is chosen here (docs/mechanical.md section 9).
// The coil is an annular sheet over the glass border, bonded to the cover's ceiling; its tail is a tongue cut from the
// sheet at theta 222 that folds down just outside the glass edge and runs under the rim relief onto J11.  Between the
// glass corners (r 25.03) and the cover keys (r 26.4) there is no room for a coil beside the glass, so it sits above.
NFC_T       = 0.15;     // TVP: 2-layer polyimide flex (PI 25 + Cu 18 + Cu 18 + coverlay), black coverlay
NFC_RI      = 15.5;     // TVP: sheet ID 31 (0.5 outside the Ø30 window, hidden under the cover)
NFC_RO      = 26.25;    // TVP: sheet OD 52.5
NFC_CU      = [24.9, 26.15];   // TVP: copper band, 4 turns 0.20/0.15 (or 3 turns 0.25/0.25); starts 0.18 past the tail root
NFC_Z0      = OLED_Z0 + OLED_T + 0.1;   // TVP: 34.8, bonded (0.05 PSA) to the cover ceiling z 35.0; 0.1 above the glass
NFC_POCKET_R = NFC_RO + 0.1;   // cover underside raised to z 35.0 inside r 26.35 (0.6 wall ring left to the diffuser bore)
NFC_TAIL_W  = 2.0;      // TVP: tail width at the folds (2 traces 0.4/0.4 + 0.4 margins); 3.4 over the J11 pads
NFC_TAIL_BR = 0.45;     // TVP: inner fold radius (3x t, one-time install fold, single copper layer in the tongue)
NFC_TAIL_RV = 24.1;     // inner face of the vertical run, radius along theta 222: 0.34 outside the glass edge (x -16.9)
J11P        = [for (p = MAIN_PARTS) if (p[0] == "J11") p][0];   // J11 joint body (pads + solder + tail end, from the PCB)
J11_R       = norm([J11P[2], J11P[3]]);
// OLED bracket rim relief over J11 (J11 frame: u along the pad row, v radially out): |u| <= 2.0, v -1.4..3.2, rim
// underside raised from z 31.8 to 32.3 (0.5 mm rim left under the glass)
J11_RELIEF  = [2.0, -1.4, 3.2, 32.3];
// tail centreline in the J11 frame (v, z): board run -> bottom fold -> vertical -> top fold -> root in the sheet
NFC_TAIL_V0 = J11P[8] + 0.05;                    // starts 0.05 beyond the J11 joint body (its soldered end is that body)
NFC_TAIL_ZB = MB_Z1 + 0.05 + NFC_T / 2;          // board run centre (on the 0.05 solder/adhesive layer)
NFC_TAIL_ZT = NFC_Z0 + NFC_T / 2;                // sheet centre
NFC_TAIL_RC = NFC_TAIL_BR + NFC_T / 2;           // centreline fold radius
NFC_TAIL_VV = NFC_TAIL_RV + NFC_T / 2 - J11_R;   // vertical run centre
function arcpts(c, r, a0, a1, n = 4) = [for (i = [0:n]) c + r * [cos(a0 + (a1 - a0) * i / n), sin(a0 + (a1 - a0) * i / n)]];
NFC_TAIL_PROF = concat(
    arcpts([NFC_TAIL_VV - NFC_TAIL_RC, NFC_TAIL_ZB + NFC_TAIL_RC], NFC_TAIL_RC, -90, 0),
    arcpts([NFC_TAIL_VV + NFC_TAIL_RC, NFC_TAIL_ZT - NFC_TAIL_RC], NFC_TAIL_RC, 180, 90));
NFC_ROOT_R  = J11_R + NFC_TAIL_VV + NFC_TAIL_RC;   // fold line in the sheet (24.7)
NFC_TONGUE_L = (NFC_TAIL_VV - NFC_TAIL_RC - J11P[7]) + PI * NFC_TAIL_RC
               + (NFC_TAIL_ZT - NFC_TAIL_ZB - 2 * NFC_TAIL_RC);   // developed tongue length, J11 inner end -> root

// ------------------------------------------------------------------
//  colours
// ------------------------------------------------------------------
c_rubber  = "#1b1b1b"; c_cup = "#3a3e45"; c_plate = "#5f6b7a"; c_carrier = "#4b5563";
c_steel   = "#c9ced4"; c_steel2 = "#9aa3ad"; c_bear = "#b8bec6"; c_brass = "#c9a227";
c_spring  = "#8f969e"; c_pcb = "#1f6f43"; c_pcb_m = "#14532d"; c_ic = "#222222";
c_conn    = "#e8e1cf"; c_module = "#b0b4b8"; c_led = "#f4f1e6"; c_N = "#d64545"; c_S = "#3b6fd6";
c_magbody = "#a7adb4"; c_detmag = "#8e44ad"; c_lightbx = "#262626"; c_diff = "#efeee6";
c_cover   = "#2b2d31"; c_glass = "#0d1117"; c_aa = "#10243a"; c_battery = "#8fa3b8";
c_kapton  = "#d08a2c"; c_coax = "#5a5a5a"; c_motor = "#6f7378"; c_hub = "#b8962e";
c_pom     = "#e9e6dc"; c_felt = "#d9cfa8"; c_lens = [0.8, 0.9, 1.0, 0.35]; c_wire = "#c0392b";
c_fr4     = "#c8b560"; c_pad = "#e85d75";

// ------------------------------------------------------------------
//  helpers
// ------------------------------------------------------------------
function pol(r, a) = [r * cos(a), r * sin(a)];
module at_polar(r, a, z = 0) translate([r * cos(a), r * sin(a), z]) rotate(a) children();
module tube(ro, ri, z0, z1, fn = fn_big)
    translate([0, 0, z0]) difference() {
        cylinder(r = ro, h = z1 - z0, $fn = fn);
        translate([0, 0, -0.01]) cylinder(r = ri, h = z1 - z0 + 0.02, $fn = fn);
    }
module rsquare(a, b, z0, z1) translate([a, z0]) square([b - a, z1 - z0]);
module chain(pts, d) for (i = [0:len(pts) - 2])
    hull() { translate(pts[i]) sphere(d = d, $fn = 12); translate(pts[i + 1]) sphere(d = d, $fn = 12); }
// radial slot of width w through everything from r = 0 outward, at angle a, z0..z1
module radial_slot(a, w, z0, z1, len = 20) rotate(a) translate([0, -w / 2, z0]) cube([len, w, z1 - z0]);
// D-flat cutter: removes material beyond x' = r - depth in direction a
module dflat_keep(a, r, depth, z0, z1) rotate(a) translate([r - depth, -10, z0]) cube([10, 20, z1 - z0]);
function is_plug(s) = len(s) > 5 && s[len(s) - 4] == "p" && s[len(s) - 3] == "l" && s[len(s) - 2] == "u" && s[len(s) - 1] == "g";
// oriented board-part box from board_parts.scad
module bpart(p) translate([p[2], p[3], p[9]]) rotate(p[4]) translate([p[5], p[7], 0])
    cube([p[6] - p[5], p[8] - p[7], p[10]]);

// ==================================================================
//  BASE (stationary): feet, cup, shelf, antenna, battery, base board, guides
// ==================================================================
module feet()
    color(c_rubber) for (a = FOOT_ANG) rotate(a - FOOT_ARC / 2)
        rotate_extrude(angle = FOOT_ARC, $fn = fn_big)
            translate([FOOT_RC - FOOT_RW / 2, 0.01]) square([FOOT_RW, FOOT_Z1 - 0.02]);

// guide column/ear i: from EAR_Z0S[i] to the stop face, merged into the wall
module guide_column(i)
    intersection() {
        hull() {
            translate([GUIDE_RS[i], 0, EAR_Z0S[i]]) cylinder(d = 7.0, h = EAR_Z1 - EAR_Z0S[i], $fn = fn_mid);
            translate([CUP_RI + 0.8, -4.5, EAR_Z0S[i]]) cube([0.1, 9, EAR_Z1 - EAR_Z0S[i]]);
        }
        cylinder(r = R_OD - 0.3, h = 50, $fn = fn_big);
        // keep the theta-180 column out of the battery envelope (pack end at x = -27.5)
        if (GUIDE_A[i] == 180) translate([BAT_HX + 0.3, -10, 0]) cube([20, 20, 50]);
    }

module base_cup()
    color(c_cup) difference() {
        union() {
            rotate_extrude($fn = fn_big) polygon([
                [0, CUP_Z0], [R_OD - 0.6, CUP_Z0], [R_OD, CUP_Z0 + 0.6], [R_OD, CUP_TOP - 0.3],
                [R_OD - 0.3, CUP_TOP], [CUP_RI, CUP_TOP], [CUP_RI, CUP_FLOOR], [0, CUP_FLOOR]]);
            for (i = [0:2]) rotate(GUIDE_A[i]) guide_column(i);
            // antenna shelf (top z 5.5), joined to the wall
            intersection() {
                translate([-SHELF_HX, SHELF_Y0, CUP_FLOOR - 0.01]) cube([2 * SHELF_HX, 20, ANT_Z0 - CUP_FLOOR + 0.01]);
                cylinder(r = CUP_RI + 0.1, h = 20, $fn = fn_big);
            }
            // support rib for the base board's theta-90 edge (SPEC)
            translate([-RIB_HX, RIB_Y[0], CUP_FLOOR - 0.01]) cube([2 * RIB_HX, RIB_Y[1] - RIB_Y[0], BB_Z0 - CUP_FLOOR + 0.01]);
            // SPEC M2 boss at r 20, theta 270 (heat-set insert M2 x 3)
            translate([BB_BOSS[0], BB_BOSS[1], CUP_FLOOR - 0.01]) cylinder(d = 5.0, h = BB_Z0 - CUP_FLOOR + 0.01, $fn = fn_mid);
            // battery end stop (theta 0 end) and side ribs
            translate([BAT_HX + 0.3, -10, CUP_FLOOR - 0.01]) cube([0.8, 20, 1.5]);
        }
        // USB-C: board-tab slot through the wall (board slides in radially, then is captured)
        translate([CUP_RI - 1.5, -(2 * BB_TAB_HW + 0.6) / 2, BB_Z0 - 0.1]) cube([5, 2 * BB_TAB_HW + 0.6, BB_T + 0.25]);
        // receptacle window (open at the wall top)
        translate([CUP_RI - 1.5, -4.65, BB_Z1 - 0.1]) cube([5, 9.3, 10]);
        // insert in the theta-270 boss
        translate([BB_BOSS[0], BB_BOSS[1], BB_Z0 - 3.6]) cylinder(d = 3.2, h = 3.7, $fn = fn_small);
        // guide columns: pin hole, spring pocket, cross-pin hole (radial, from outside)
        for (i = [0:2]) rotate(GUIDE_A[i]) translate([GUIDE_RS[i], 0, 0]) {
            translate([0, 0, SPRING_SEAT]) cylinder(d = SPRING_D, h = 5, $fn = fn_small);
            translate([0, 0, EAR_Z0S[i] - 0.1]) cylinder(d = PIN_D - 0.05, h = 15, $fn = fn_small);   // knurled press fit
            translate([0, 0, XPIN_Z[i]]) rotate([0, 90, 0]) cylinder(d = 1.0, h = 10, $fn = 12);
        }
    }

module antenna() color(c_kapton) translate([-ANT_L / 2, ANT_YC - ANT_W / 2, ANT_Z0]) cube([ANT_L, ANT_W, ANT_T]);

module battery()
    color(c_battery) translate([-BAT_HX, -BAT_HY, BAT_Z0 + 0.02]) {
        translate([1.5, 1.5, 0]) minkowski() {
            cube([2 * BAT_HX - 3, 2 * BAT_HY - 3, BAT_T - 1.04]);
            cylinder(r = 1.5, h = 1, $fn = 16);
        }
    }

module base_board_outline()
    union() {
        circle(r = BB_R, $fn = fn_big);
        translate([0, -BB_TAB_HW]) square([BB_TAB_X, 2 * BB_TAB_HW]);
    }
module base_board_pcb()
    color(c_pcb) difference() {
        translate([0, 0, BB_Z0]) linear_extrude(BB_T) base_board_outline();
        for (h = BASE_HOLES) translate([h[0], h[1], BB_Z0 - 1]) cylinder(d = 2.2, h = 4, $fn = 12);
    }
// SW1 modelled explicitly (body, legs, actuator); the rest comes from the PCB file
module press_switch() {
    color(c_ic) translate([-SW_S / 2, -SW_S / 2, BB_Z1]) cube([SW_S, SW_S, SW_BODY_H]);
    color(c_ic) translate([-3.25, -1.0, BB_Z1]) cube([6.5, 2.0, 0.3]);
    color("#cccccc") translate([0, 0, BB_Z1]) cylinder(d = SW_ACT_D, h = SW_H, $fn = 16);
}
module base_top_parts() {
    for (p = BASE_PARTS) if (p[1] == "T" && p[0] != "SW1") color(is_plug(p[0]) ? "#f0c27b" : c_conn) bpart(p);
    press_switch();
}
module base_bottom_parts() for (p = BASE_PARTS) if (p[1] == "B") color(c_ic) bpart(p);
module base_board() { base_board_pcb(); if (show_board_parts) { base_top_parts(); base_bottom_parts(); } }

// battery leads: pack end (theta 180) -> past the board edge -> J2 plug back face (as placed)
J2P = [for (p = BASE_PARTS) if (p[0] == "J2_plug") p][0];
function bp_point(p, u, v, z) = [p[2] + u * cos(p[4]) - v * sin(p[4]), p[3] + u * sin(p[4]) + v * cos(p[4]), z];
// pack end (theta 180) -> beside the pack below the spider (z 10, under its under-bosses at 12.0) -> up over the
// base-board edge at theta ~222 -> J2 plug back (SH 4-pin, mouth radially outward)
LEAD_PTS = [
    [-BAT_HX, BAT_LEAD_Y, BAT_Z0 + 3.0], [-BAT_HX - 1.5, BAT_LEAD_Y, BAT_Z0 + 3.5],
    [-BAT_HX - 1.5, BAT_LEAD_Y - 1.0, 10.0], concat(pol(28.5, 205), [10.0]), concat(pol(24.8, 220), [10.0]),
    bp_point(J2P, 0, J2P[7] - 1.0, BB_Z1 + 1.3)];
module battery_leads() color(c_wire) chain(LEAD_PTS, 1.8);

// guide pins (brass Ø3, pressed + bonded + cross-pinned), stop screws, springs
module guide_pins()
    for (i = [0:2]) rotate(GUIDE_A[i]) translate([GUIDE_RS[i], 0, 0]) {
        color(c_brass) translate([0, 0, EAR_Z0S[i]]) cylinder(d = PIN_D, h = CBORE_FLOOR - EAR_Z0S[i], $fn = fn_small);
        color(c_brass) translate([0, 0, CBORE_FLOOR]) cylinder(d = HEAD_D, h = HEAD_H, $fn = fn_small);   // M2 pan head (stop)
        color(c_brass) translate([-PIN_D / 2 - 0.5, 0, XPIN_Z[i]]) rotate([0, 90, 0]) cylinder(d = 1.0, h = CUP_RI + 1.5 - GUIDE_RS[i] + PIN_D / 2, $fn = 10);
    }
module guide_springs()
    for (i = [0:2]) rotate(GUIDE_A[i]) translate([GUIDE_RS[i], 0, 0]) {
        sz0 = SPRING_SEAT; sz1 = PLATE_POCKET_TOP - press * STOP_TRAVEL;
        color(c_spring) for (k = [0:4]) translate([0, 0, sz0 + 0.17 + k * (sz1 - sz0 - 0.34) / 4])
            rotate_extrude($fn = 20) translate([1.815, 0]) circle(d = 0.32, $fn = 8);
    }
module guide_hw() { guide_pins(); guide_springs(); }

// ==================================================================
//  FLOATING ASSEMBLY (non-rotating part): spider plate, spindle, pad, spacer, hub, nut
// ==================================================================
module fa_outline()
    difference() {
        union() {
            circle(r = FA_HUB_R, $fn = fn_mid);
            for (a = SPOKE_A) rotate(a - SPOKE_HALF) intersection() {
                circle(r = FA_RING[0] + 0.5, $fn = fn_big);
                polygon([[0, 0], [40, 0], pol(40, 2 * SPOKE_HALF)]);
            }
            difference() { circle(r = FA_RING[1], $fn = fn_big); circle(r = FA_RING[0], $fn = fn_big); }
            for (i = [0:2]) rotate(GUIDE_A[i]) hull() {
                translate([GUIDE_RS[i], 0]) circle(d = FA_BOSS_D + 0.2, $fn = fn_mid);
                translate([GUIDE_RS[i] - 3, 0]) circle(d = FA_BOSS_D + 0.2, $fn = fn_mid);
            }
        }
        translate([FA_RING[0] - 2, -USB_NOTCH_HY]) square([12, 2 * USB_NOTCH_HY]);
    }

module fa_lower_plate()
    color(c_plate) difference() {
        union() {
            translate([0, 0, FA_Z0]) linear_extrude(FA_Z1 - FA_Z0) fa_outline();
            for (i = [0:2]) rotate(GUIDE_A[i]) translate([GUIDE_RS[i], 0, FA_BOSS_Z0])
                cylinder(d = FA_BOSS_D, h = FA_Z0 - FA_BOSS_Z0 + 0.01, $fn = fn_mid);
        }
        for (i = [0:2]) rotate(GUIDE_A[i]) translate([GUIDE_RS[i], 0, 0]) {
            translate([0, 0, FA_BOSS_Z0 - 0.1]) cylinder(d = SPRING_D, h = PLATE_POCKET_TOP - FA_BOSS_Z0 + 0.1, $fn = fn_small);
            translate([0, 0, FA_BOSS_Z0 - 1]) cylinder(d = PIN_D + 0.05, h = 5, $fn = fn_small);   // reamed Ø3.05
            translate([0, 0, CBORE_FLOOR]) cylinder(d = HEAD_D + 0.8, h = 2, $fn = fn_small);
        }
        // spindle: Ø8 through the hub, flange recess (with D-flat) from below
        translate([0, 0, FA_Z0 - 1]) cylinder(d = SP_OD + 0.03, h = 5, $fn = fn_mid);
        translate([0, 0, FA_Z0 - 0.01]) intersection() {
            cylinder(d = SP_FL_D + 0.1, h = SP_FL_T + 0.01, $fn = fn_mid);
            rotate(90) translate([-10, -10, -1]) cube([10 + SP_FL_D / 2 - FLAT_DEPTH + 0.05, 20, 3]);
        }
    }

module spindle()
    color(c_steel2) difference() {
        union() {
            // bottom flange (D-flat at theta 90 keys the spindle to the plate)
            translate([0, 0, SP_Z0]) intersection() {
                cylinder(d = SP_FL_D, h = SP_FL_T, $fn = fn_mid);
                rotate(90) translate([-10, -10, -1]) cube([10 + SP_FL_D / 2 - FLAT_DEPTH, 20, 3]);
            }
            translate([0, 0, SP_Z0]) cylinder(d = SP_OD, h = SP_Z1 - SP_Z0, $fn = fn_mid);
            translate([0, 0, SP_Z1 - 0.01]) cylinder(d = SPIGOT_D, h = SPIGOT_Z1 - SP_Z1 + 0.01, $fn = fn_small);
        }
        translate([0, 0, SP_BORE_Z0]) cylinder(d = SP_ID, h = SP_BORE_Z1 - SP_BORE_Z0, $fn = fn_mid);
        translate([0, 0, SP_Z0 - 0.01]) cylinder(d = SP_RELIEF_D, h = SP_RELIEF_H + 0.01, $fn = fn_mid);
        translate([0, 0, SP_Z0 + SP_RELIEF_H - 0.01]) cylinder(d = PAD_POCKET_D, h = PAD_POCKET_H + 0.01, $fn = fn_small);
        radial_slot(BOT_SLOT_A, SLOT_W, BOT_SLOT_Z[0], BOT_SLOT_Z[1], 6);
        radial_slot(TOP_SLOT_A, SLOT_W, TOP_SLOT_Z[0], TOP_SLOT_Z[1], 6);
        // D-flats for the spacer (z 14.3-18) and hub (z 25-29.05) at theta 90
        for (zz = [[FA_Z0, 18.0], [B_Z1, SP_Z1]]) dflat_keep(90, SP_OD / 2, FLAT_DEPTH, zz[0], zz[1]);
    }
module press_pad() color(c_pad) translate([0, 0, PAD_Z0]) cylinder(d = PAD_D, h = PAD_T, $fn = fn_small);

// lower spacer (brass): clamps the inner race, carries the drop-stop flange; window for the wires
module lower_spacer()
    color(c_hub) difference() {
        union() {
            tube(LS_RO, SP_OD / 2, FA_Z1, B_Z0, fn_mid);
            tube(LS_FL_RO, LS_RO - 0.01, LS_FL_Z0, LS_FL_Z1, fn_mid);
        }
        radial_slot(BOT_SLOT_A, SLOT_W, FA_Z1 - 0.1, BOT_SLOT_Z[1], 12);
    }

// hub (turned brass): upper inner-race spacer + flange r <= 8.5, 3x M2 tapped at r 6.5, C-gap for the wires
module spindle_hub()
    color(c_hub) difference() {
        union() {
            tube(LS_RO, SP_OD / 2, B_Z1, HUB_FL_Z0 + 0.01, fn_mid);
            tube(HUB_FL_RO, SP_OD / 2, HUB_FL_Z0, MB_Z0, fn_mid);
        }
        for (a = HUB_SCREW_A) at_polar(HUB_SCREW_R, a, MB_Z0 - 2.6) cylinder(d = 1.6, h = 2.7, $fn = fn_small);
        radial_slot(TOP_SLOT_A, SLOT_W, B_Z1 - 0.1, MB_Z0 + 0.1, 12);
    }
module hub_nut() color(c_hub) difference() {     // M4 x 0.5 brass round nut, 2 spanner holes
    tube(NUT_OD / 2, SPIGOT_D / 2, MB_Z1, MB_Z1 + NUT_H, fn_small);
    for (s = [-1, 1]) translate([s * 2.6, 0, MB_Z1 + 0.6]) cylinder(d = 0.8, h = 1, $fn = 8);
}

// ==================================================================
//  ROTOR: 316L ring + 48 magnets + PA12-GF carrier + 608 outer race + seat parts
// ==================================================================
module ring_profile()
    polygon([
        [RING_RI + CH_IN, RING_Z0], [RING_RO - CH_BO, RING_Z0], [RING_RO, RING_Z0 + CH_BO],
        [RING_RO, RING_Z1 - CH_TO], [RING_RO - CH_TO, RING_Z1], [RING_RI + CH_IN, RING_Z1],
        [RING_RI, RING_Z1 - CH_IN], [RING_RI, RING_Z0 + CH_IN]]);

module rotor_ring()
    color(c_steel) difference() {
        rotate_extrude($fn = fn_big * 2) ring_profile();
        for (i = [0:MAG_N - 1]) rotate(i * 360 / MAG_N)
            translate([RT, 0, RING_Z1 - POCKET_H]) cylinder(d = POCKET_D, h = POCKET_H + 0.1, $fn = fn_small);
        for (a = [45:90:315]) rotate(a) translate([31, 0, RING_Z0 - 0.1]) cylinder(d = 1.6, h = 3.1, $fn = 12);
        if (show_knurl) for (i = [0:119]) rotate(i * 3)
            translate([RING_RO, 0, RING_Z0 + 1.5]) rotate(45) translate([-0.3, -0.3, 0]) cube([0.6, 0.6, 7.0]);
    }

module track_magnets()
    for (i = [0:MAG_N - 1]) rotate(i * 360 / MAG_N) translate([RT, 0, RING_Z1 - MAG_H]) {
        color(c_magbody) cylinder(d = MAG_D, h = MAG_H - 0.06, $fn = fn_small);
        color(i % 2 == 0 ? c_N : c_S) translate([0, 0, MAG_H - 0.06]) cylinder(d = MAG_D, h = 0.05, $fn = fn_small);
    }

module carrier_profile()
    union() {
        rsquare(COLLAR_RO - 0.01, RING_RI - 0.05, CW_Z0, CW_Z1);       // web + bonding register (r 26.95)
        rsquare(COLLAR_RI, COLLAR_RO, CW_Z0, COLLAR_Z1);               // bearing collar (bored H7)
        rsquare(LIP_RI, COLLAR_RI + 0.01, CW_Z0, B_Z0);                // outer-race seat lip
    }
module rotor_carrier() color(c_carrier) rotate_extrude($fn = fn_big) carrier_profile();
module wave_spring() color(c_spring) tube(10.95, CAP_RI, WS_Z[0], WS_Z[1], fn_mid);
module cap_ring() color(c_steel2) tube(COLLAR_RO, CAP_RI, CAP_Z[0], CAP_Z[1], fn_mid);
// ESD bleed strap (SPEC: ring -> conductive epoxy -> 608 races): 0.1 x 3 phosphor bronze on the web,
// up the collar and under the cap ring, which touches the outer race through the wave washer
module esd_strap() color("#b87333") {
    translate([COLLAR_RO, -1.5, CW_Z1]) cube([RING_RI - COLLAR_RO - 0.05, 3, 0.1]);
    translate([COLLAR_RO, -1.5, CW_Z1]) cube([0.1, 3, CAP_Z[0] - CW_Z1]);
}

module bearing608() {
    color(c_bear) {
        tube(6.05, B_d / 2, B_Z0, B_Z1, fn_mid);
        tube(B_D / 2, 9.55, B_Z0, B_Z1, fn_mid);
    }
    color("#7d848c") {
        tube(9.56, 6.2, B_Z0 + 0.3, B_Z0 + 0.5, fn_mid);
        tube(9.56, 6.2, B_Z1 - 0.5, B_Z1 - 0.3, fn_mid);
    }
    color(c_bear) for (i = [0:6]) rotate(i * 360 / 7) translate([7.6, 0, (B_Z0 + B_Z1) / 2]) sphere(d = 3.97, $fn = 16);
}

module rotor() { rotor_ring(); track_magnets(); rotor_carrier(); wave_spring(); cap_ring(); esd_strap(); }

// swept envelope of everything that rotates (for the clash check)
module rotor_envelope2d()
    offset(delta = clash_margin) union() {
        ring_profile();
        carrier_profile();
        rsquare(9.55, B_D / 2, B_Z0, B_Z1);                 // outer race + shields
        rsquare(6.2, 9.56, B_Z0 + 0.3, B_Z1 - 0.3);
        rsquare(CAP_RI, COLLAR_RO, WS_Z[0], CAP_Z[1]);      // wave washer + cap ring
        rsquare(COLLAR_RO, COLLAR_RO + 0.11, CW_Z1, CAP_Z[0]);   // ESD strap on the collar
        rsquare(COLLAR_RO, RING_RI, CW_Z1, CW_Z1 + 0.11);       // ESD strap on the web
    }
module rotor_envelope() rotate_extrude($fn = fn_big) rotor_envelope2d();

// ==================================================================
//  MAIN BOARD and its parts (from the PCB)
// ==================================================================
module main_board_pcb()
    color(c_pcb_m) difference() {
        translate([0, 0, MB_Z0]) cylinder(r = MB_R, h = MB_T, $fn = fn_big);
        translate([0, 0, MB_Z0 - 1]) cylinder(d = 5, h = 5, $fn = fn_small);
        for (h = MAIN_HOLES) translate([h[0], h[1], MB_Z0 - 1]) cylinder(d = 2.2, h = 5, $fn = 12);
    }
module main_top_parts()
    for (p = MAIN_PARTS) if (p[1] == "T") color(p[0] == "J11" ? "#d0d0d0" : p[10] > 1.2 ? c_ic : c_led) bpart(p);
module main_bottom_parts()
    for (p = MAIN_PARTS) if (p[1] == "B")
        color(p[0] == "U10" ? c_module : p[0] == "U10_uFL" ? "#d4af37" : is_plug(p[0]) ? "#f0c27b" : c_ic) bpart(p);
module board_screws() {
    for (a = HUB_SCREW_A) at_polar(HUB_SCREW_R, a, BRK_Z1 - 1.1) color(c_brass) cylinder(d1 = 2.0, d2 = 3.8, h = 1.1, $fn = 12);
    at_polar(MB_BRK_R, MB_BRK_A[0], MB_Z1) color(c_brass) cylinder(d = 3.8, h = 1.3, $fn = 16);
}
module main_board() {
    main_board_pcb();
    if (show_board_parts) { main_top_parts(); main_bottom_parts(); }
}

// link harness: base J3 plug back -> bottom slot -> bore -> top slot -> J1 plug back (as placed)
J3P = [for (p = BASE_PARTS) if (p[0] == "J3_plug") p][0];
J1P = [for (p = MAIN_PARTS) if (p[0] == "J1_plug") p][0];
UFLP = [for (p = MAIN_PARTS) if (p[0] == "U10_uFL") p][0];
HARN_D = 1.8;     // 5x 28 AWG (OD 0.75) + 7x 32 AWG (OD 0.55): 2 x 6 ribbon, 4.5 x 1.5, modelled as a Ø1.8 chain
HARN_PTS = [
    bp_point(J3P, 0, J3P[7] - 1.05, BB_Z1 + 1.5), bp_point(J3P, 0, J3P[7] - 2.5, 15.1),
    concat(pol(7.5, BOT_SLOT_A + 8), [15.3]), concat(pol(3.6, BOT_SLOT_A), [15.4]), [0, 0, 15.4],
    [0, 0, 26.2], concat(pol(3.8, TOP_SLOT_A), [26.9]),
    // out of the hub C-gap past the flange (r 8.5), under C11/R12 (bottom z 28.55/28.7) and over the cap ring
    // (top z 26.0), clear of U12 (r 11, theta 260); then between the hub flange and C1/R1
    [0.3, -9.3, 27.35], [2.5, -10.0, 27.35], [5.5, -8.6, 27.35], [8.6, -7.0, 27.35],
    bp_point(J1P, 0, J1P[8] + 1.0, 27.6)];   // ends at the J1 plug back face (route for the current PCB)
module harness() color(c_wire) chain(HARN_PTS, HARN_D);
// antenna coax (Ø1.13): feed end -> riser outside the base board -> bottom slot -> bore -> top slot -> u.FL
COAX_PTS = [
    [ANT_FEED_X, ANT_YC, ANT_Z0 + 0.65], [ANT_FEED_X + 1.0, ANT_YC - 2.0, ANT_Z0 + 1.2],
    [-14.6, 19.9, 7.5], [-14.6, 19.9, 14.2], [-12.0, 17.0, 15.0],
    concat(pol(8.0, BOT_SLOT_A - 6), [15.3]), concat(pol(3.4, BOT_SLOT_A - 10), [15.4]), [0.6, 0.3, 16.2],
    [0.6, 0.3, 26.0], concat(pol(3.6, TOP_SLOT_A - 15), [26.6]), concat(pol(8.9, TOP_SLOT_A - 12), [27.0]),
    // over the rotating hub (cap ring top 26.0) while r < 12.6, threading between U12 (r 11, theta 260, bottom
    // z 27.65) and the module's inner corner, then down to z 26.0 beside the module (u.FL faces outward)
    concat(pol(12.5, 244), [27.0]), concat(pol(14.5, 246), [26.0]), concat(pol(23.5, 242), [26.0]),
    [UFLP[2] + 1.9, UFLP[3] - 1.9, 26.2]];   // ends at the u.FL plug body face (plug box ±1.3)
module coax() color(c_coax) chain(COAX_PTS, 1.13);

// ==================================================================
//  DETENT: rails, carriage + Ø3x2 magnet + shoe + FR4 link, stepper placeholder
// ==================================================================
CAR_STRIP = [[0, -3.0], [-3.0, -4.3], [-5.0, -6.0], [-15.0, -13.5]];   // link plate centre line (local)
module carriage_rails()
    color("#b9b9b9") for (s = [-1, 1]) mirror([s < 0 ? 1 : 0, 0, 0]) {
        translate([RAIL_X[0], RAIL_Y[0], MB_Z0 - 1.0]) cube([RAIL_X[1] - RAIL_X[0], RAIL_Y[1] - RAIL_Y[0], 1.0]);   // upright
        translate([2.6, RAIL_Y[0], MB_Z0 - 1.0]) cube([RAIL_X[1] - 2.6, RAIL_Y[1] - RAIL_Y[0], 0.5]);            // lip
    }
// local frame: origin = detent-magnet centre, z = 0 at its bottom face, +y radially out
module carriage_body_local()
    difference() {
        union() {
            translate([-2.95, -2.5, 2.0]) cube([5.9, 5.0, CARR_T]);                // plate (between rails)
            translate([-1.5, 2.4, 2.0]) cube([3.0, 1.0, CARR_T]);                  // shoe tongue
            cylinder(d = 4.0, h = 2.01, $fn = fn_small);                           // magnet cup
            translate([-1.2, -3.6, 0.4]) cube([2.4, 1.2, 1.7]);                    // web down to the link
            translate([-1.5, 2.6, -0.05]) cube([3.0, 0.8, 2.1]);                   // shoe hanger (flexure, 0.5 lift ramp)
        }
        translate([0, 0, -0.1]) cylinder(d = DET_D + 0.08, h = DET_H + 0.1, $fn = fn_small);
    }
module link_plate_local()     // 0.8 mm FR4/G10, bonded under the carriage web; inclined slot 1.6 wide
    difference() {
        for (i = [0:len(CAR_STRIP) - 2]) hull() {
            translate([CAR_STRIP[i][0], CAR_STRIP[i][1], LINK_Z[0]]) cylinder(d = 3.0, h = LINK_Z[1] - LINK_Z[0], $fn = 16);
            translate([CAR_STRIP[i + 1][0], CAR_STRIP[i + 1][1], LINK_Z[0]]) cylinder(d = 3.0, h = LINK_Z[1] - LINK_Z[0], $fn = 16);
        }
        hull() {
            translate([CAR_STRIP[2][0] + 0.8, CAR_STRIP[2][1] + 0.6, -0.1]) cylinder(d = 1.6, h = 1.5, $fn = 12);
            translate([CAR_STRIP[3][0] - 0.8, CAR_STRIP[3][1] - 0.6, -0.1]) cylinder(d = 1.6, h = 1.5, $fn = 12);
        }
    }
module detent_carriage_local() { carriage_body_local(); link_plate_local(); }
module detent_carriage_placed(off)
    translate([0, DET_R_CLICK - off, DET_Z0]) {
        color("#e2e2e2") carriage_body_local();
        color(c_fr4) link_plate_local();
        color(c_detmag) cylinder(d = DET_D, h = DET_H, $fn = fn_small);
        color(c_felt) translate([-1.5, 2.6, -0.95]) cube([3.0, 0.8, 0.9]);        // felt/UHMW shoe
    }

module stepper(off) {
    xs = -15.0 + off * ST_STROKE / DET_STROKE;     // slider pin x (world)
    color(c_motor) {
        translate([ST_CAN_X[0], ST_Y, ST_ZA]) rotate([0, 90, 0]) cylinder(d = ST_CAN_D, h = ST_CAN_X[1] - ST_CAN_X[0], $fn = fn_mid);
        translate([ST_CAN_X[0] - 1, ST_Y - 4, ST_ZA - 4]) cube([1, 8, 8]);                 // front plate
        translate([ST_SCREW_X[0] - 1, ST_Y - 2.5, ST_ZA - 4]) cube([1, 5, 5.5]);            // end tab
        translate([ST_SCREW_X[0] - 1, ST_Y - 2, ST_ZA - 4]) cube([ST_CAN_X[0] - ST_SCREW_X[0] + 1, 4, 0.5]); // bracket bar
    }
    color("#b0b0b0") translate([ST_SCREW_X[0], ST_Y, ST_ZA]) rotate([0, 90, 0]) cylinder(d = 2, h = ST_SCREW_X[1] - ST_SCREW_X[0], $fn = 12);
    color("#d9d9d9") translate([xs - 2.5, ST_Y - 2, ST_ZA - 2]) cube([5, 4, 4]);           // slider nut (anti-backlash)
    color(c_brass) translate([xs, ST_Y, ST_ZA + 2]) cylinder(d = 1.5, h = DET_Z0 + LINK_Z[1] + 0.1 - ST_ZA - 2, $fn = 12);
    color("#b87333") translate([xs - 0.15, ST_Y - 2.0, ST_ZA + 2]) cube([0.3, 1.2, 1.4]);  // PB leaf: pin preload in the slot
}
// printed saddle: bonded to the can, M2 into the board hole at (r 17, theta 60)
module stepper_saddle()
    color("#9c8f7a") difference() {
        translate([7.0, ST_Y - 4.6, ST_ZA + 1.5]) cube([3.6, 9.2, MB_Z0 - ST_ZA - 1.5]);
        translate([6.0, ST_Y, ST_ZA]) rotate([0, 90, 0]) cylinder(d = ST_CAN_D + 0.1, h = 6, $fn = fn_mid);
        at_polar(MB_BRK_R, MB_BRK_A[0], MB_Z0 - 3.2) cylinder(d = 3.2, h = 3.3, $fn = fn_small);
    }
module detent_assembly(off = det_offset) { carriage_rails(); detent_carriage_placed(off); stepper(off); stepper_saddle(); }

// ==================================================================
//  OPTICS + DISPLAY + COVER (on the main-board top)
// ==================================================================
module light_box()
    color(c_lightbx) difference() {
        union() {
            tube(LB_RI + LB_WALL, LB_RI, LB_Z0 + 0.1, LB_Z1);
            tube(LB_RO, LB_RO - LB_WALL, LB_Z0 + 0.1, LB_Z1);
            for (i = [0:SEPTA_N - 1]) rotate(i * 360 / SEPTA_N - 360 / LED_N / 2)
                translate([LB_RI + 0.01, -0.3, MB_Z1]) cube([LB_RO - LB_RI - 0.02, 0.6, LB_Z1 - MB_Z1]);
        }
        for (i = [0:5]) rotate(i * 60 - 360 / LED_N / 2)
            translate([LB_RI - 0.1, -0.5, LB_Z1 - 0.8]) cube([LB_RO - LB_RI + 0.2, 1.0, 1]);
    }
module diffuser() color(c_diff) tube(DIF_RO - 0.02, DIF_RI + 0.02, COV_Z0 + 0.02, COV_Z1 - 0.02);

// OLED bracket: rim under the glass edge + 3 spokes to the hub-screw bosses; centre clears the nut
module oled_bracket()
    color("#4d4d4d") difference() {
        union() {
            translate([0, OLED_YC, BRK_Z1 - BRK_RIM_T]) linear_extrude(BRK_RIM_T) difference() {
                square([OLED_W - 0.4, OLED_L - 0.4], center = true);
                square([OLED_W - 4.4, OLED_L - 4.4], center = true);
            }
            for (a = HUB_SCREW_A) at_polar(HUB_SCREW_R, a, MB_Z1 + 0.05) cylinder(d = 4.4, h = BRK_Z1 - MB_Z1 - 0.05, $fn = fn_small);
            intersection() {     // spokes from the screw bosses out to the rim
                for (a = HUB_SCREW_A) rotate(a) translate([HUB_SCREW_R, -1.0, BRK_Z1 - BRK_RIM_T]) cube([14, 2.0, BRK_RIM_T]);
                translate([0, OLED_YC, 0]) cube([OLED_W - 0.6, OLED_L - 0.6, 100], center = true);
            }
        }
        for (a = HUB_SCREW_A) at_polar(HUB_SCREW_R, a, MB_Z1 - 0.1) {
            cylinder(d = 2.3, h = 5, $fn = 12);
            translate([0, 0, BRK_Z1 - MB_Z1 + 0.1 - 1.0]) cylinder(d1 = 2.3, d2 = 3.9, h = 1.01, $fn = 16);   // M2 CSK, open at the top
        }
        translate([0, 0, MB_Z1 - 0.1]) cylinder(d = NUT_OD + 1.0, h = 3, $fn = fn_small);
        for (a = MB_BRK_A) at_polar(MB_BRK_R, a, MB_Z1 - 0.1) cylinder(d = 4.8, h = 3, $fn = 16);   // saddle screw heads
        translate([0, OLED_YC - OLED_L / 2 - 1, MB_Z1]) translate([-9.0, 0, 0]) cube([18, 4.5, 3]);   // FPC fold relief
        // NFC tail relief over the J11 joint and the tail's board run (rim underside 31.8 -> 32.3, 0.5 mm rim left)
        translate([J11P[2], J11P[3], MB_Z1 - 0.1]) rotate(J11P[4])
            translate([-J11_RELIEF[0], J11_RELIEF[1], 0])
                cube([2 * J11_RELIEF[0], J11_RELIEF[2] - J11_RELIEF[1], J11_RELIEF[3] - MB_Z1 + 0.1]);
        // pockets over every top-side part taller than 0.95 mm (0.3 mm all round, 0.2 above)
        for (p = MAIN_PARTS) if (p[1] == "T" && p[10] > 0.95) translate([p[2], p[3], p[9] - 0.1]) rotate(p[4])
            translate([p[5] - 0.31, p[7] - 0.31, 0])
                cube([p[6] - p[5] + 0.62, p[8] - p[7] + 0.62, p[9] + p[10] + 0.6 > BRK_Z1 ? 5 : p[10] + 0.31]);
    }

module oled_glass() {
    color(c_glass) translate([-OLED_W / 2, OLED_YC - OLED_L / 2, OLED_Z0]) cube([OLED_W, OLED_L, OLED_T]);
    color(c_aa) translate([-OLED_AA / 2, -OLED_AA / 2, OLED_Z0 + OLED_T]) cube([OLED_AA, OLED_AA, 0.02]);
    color(c_kapton) {
        translate([-7.5, OLED_YC - OLED_L / 2 - 0.9, MB_Z1 + 2.2]) cube([15, 0.12, OLED_Z0 - MB_Z1 - 2.0]);
        translate([-7.5, -9.5 - 3.5, MB_Z1 + 2.1]) cube([15, 4.5, 0.12]);
    }
}

module top_cover()
    color(c_cover) difference() {
        union() {
            tube(COV_R, WIN_D / 2, COV_Z0, COV_Z1);
            tube(COV_R, 30.6, MB_Z1 + 0.05, COV_Z0 + 0.01);                          // skirt to the board top
            for (i = [0:5]) rotate(i * 60 - 360 / LED_N / 2)
                translate([DIF_RI - 0.6, -0.45, LB_Z1 - 0.8]) cube([DIF_RO - DIF_RI + 1.2, 0.9, 0.9]);
            for (a = [30, 150, 270]) rotate(a) translate([30.05, -1.5, LB_Z0 + 0.3]) cube([0.6, 3.0, COV_Z0 - LB_Z0]);
        }
        translate([0, 0, COV_Z0]) difference() {
            cylinder(r = DIF_RO + 0.05, h = 3, $fn = fn_big);
            translate([0, 0, -1]) cylinder(r = DIF_RI - 0.05, h = 5, $fn = fn_big);
        }
        // NFC coil pocket (replaces the rectangular glass pocket it contains): the underside inside r 26.35 is raised
        // to z 35.0, 0.3 above the OLED glass as before; the coil sheet is bonded to this ceiling.  The 0.6 mm ring
        // r 26.35-26.95 carries the 6 keys.  The glass is no longer boxed in by the cover (it is placed with a jig).
        translate([0, 0, COV_Z0 - 1]) cylinder(r = NFC_POCKET_R, h = OLED_Z0 + OLED_T + 0.3 - COV_Z0 + 1, $fn = fn_big);
        translate([0, 0, COV_Z1 - LENS_T]) cylinder(d = LENS_D + 0.1, h = 1, $fn = fn_big);
    }
module window_lens() color(c_lens) translate([0, 0, COV_Z1 - LENS_T]) cylinder(d = LENS_D, h = LENS_T, $fn = fn_big);

// NFC coil: annular sheet (black coverlay) with the copper band drawn on top; slot where the tail tongue was cut out
module nfc_tongue_slot(kerf = 0.2)
    translate([J11P[2], J11P[3], 0]) rotate(J11P[4]) {
        v_tip = NFC_ROOT_R - J11_R - NFC_TONGUE_L;          // tongue tip (J11 inner end) in the flat sheet
        translate([-NFC_TAIL_W / 2 - kerf, v_tip - kerf]) square([NFC_TAIL_W + 2 * kerf, NFC_ROOT_R - J11_R - v_tip + kerf]);
        translate([J11P[5] - kerf, v_tip - kerf]) square([J11P[6] - J11P[5] + 2 * kerf, J11P[8] - J11P[7] + 1.0 + kerf]);
    }
module nfc_coil() {
    color("#151515") translate([0, 0, NFC_Z0]) linear_extrude(NFC_T) difference() {
        circle(r = NFC_RO, $fn = fn_big);
        circle(r = NFC_RI, $fn = fn_big);
        nfc_tongue_slot();
    }
    color("#b87333") translate([0, 0, NFC_Z0 + NFC_T - 0.01]) linear_extrude(0.02) difference() {   // copper turns band
        circle(r = NFC_CU[1], $fn = fn_big);
        circle(r = NFC_CU[0], $fn = fn_big);
    }
}
// tail: board run (3.4 wide over J11 -> 2.0) + folded part (constant width), J11 frame
module nfc_tail() color("#c8892a") translate([J11P[2], J11P[3], 0]) rotate(J11P[4]) {
    v1 = NFC_TAIL_VV - NFC_TAIL_RC;
    translate([0, 0, NFC_TAIL_ZB - NFC_T / 2]) linear_extrude(NFC_T)
        polygon([[J11P[5], NFC_TAIL_V0], [J11P[6], NFC_TAIL_V0], [NFC_TAIL_W / 2, NFC_TAIL_V0 + 0.65],
                 [NFC_TAIL_W / 2, v1 + 0.01], [-NFC_TAIL_W / 2, v1 + 0.01], [-NFC_TAIL_W / 2, NFC_TAIL_V0 + 0.65]]);
    rotate([90, 0, 90]) linear_extrude(height = NFC_TAIL_W, center = true)
        for (i = [0:len(NFC_TAIL_PROF) - 2]) hull() {
            translate(NFC_TAIL_PROF[i]) circle(d = NFC_T, $fn = 8);
            translate(NFC_TAIL_PROF[i + 1]) circle(d = NFC_T, $fn = 8);
        }
}

