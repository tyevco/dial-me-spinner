module label(t, p, sz = 1.9, ha = "center")
    color("#111111") translate([p[0], p[1], 14]) mirror([0, 1, 0]) linear_extrude(0.2)
        text(t, size = sz, halign = ha, valign = "center", font = "DejaVu Sans:style=Bold");
// SPEC section 8 bottom-side rules as outlines on the board underside: keep-out sector (yellow), actuator corridor
// (orange) and rotating hub zone (cyan)
module sector_outline(a, r, w = 0.8) {
    da = w / r[1] * 180 / PI;
    difference() {
        intersection() { circle(r = r[1], $fn = fn_big); polygon([[0, 0], pol(60, a[0]), pol(60, (a[0] + a[1]) / 2), pol(60, a[1])]); }
        circle(r = r[0], $fn = fn_big);
        intersection() {
            circle(r = r[1] - w, $fn = fn_big);
            polygon([[0, 0], pol(60, a[0] + da), pol(60, (a[0] + a[1]) / 2), pol(60, a[1] - da)]);
            difference() { circle(r = 60); circle(r = r[0] + w, $fn = fn_big); }
        }
    }
}
module spec_keepout_overlay() {
    color("#f2c200") translate([0, 0, MB_Z0 - 0.08]) linear_extrude(0.06) sector_outline(KO_SECTOR, KO_R, 1.0);
    color("#e8590c") translate([0, 0, MB_Z0 - 0.16]) linear_extrude(0.06) sector_outline(CORRIDOR_A, CORRIDOR_R, 0.6);
    color("#15aabf") translate([0, 0, MB_Z0 - 0.12]) linear_extrude(0.06) difference() {
        circle(r = HUB_ZONE_R[1], $fn = fn_big); circle(r = HUB_ZONE_R[0], $fn = fn_big); }
}
