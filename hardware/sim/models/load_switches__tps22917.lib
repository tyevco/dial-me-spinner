* =====================================================================================================
* load_switches__tps22917.lib  --  TI TPS22917 1-5.5 V, 2 A, 80 mOhm load switch (U2 LED rail, U21 OLED boost)
* =====================================================================================================
* Part      : Texas Instruments TPS22917DBVR (SOT-23-6, active-high ON), LCSC C2681320
* Datasheet : https://www.ti.com/lit/ds/symlink/tps22917.pdf  SLVSDW8B (Sept 2017, revised Dec 2021)
* Source    : TI "TPS22917 Unencrypted PSpice Transient Model", SLVMCE8 (https://www.ti.com/lit/zip/SLVMCE8),
*             file TPS22917_TRANS.LIB, "Final 1.00", 14DEC2017, (C) 2017 Texas Instruments.
*             The vendor netlist is reproduced below element for element.  The ONLY changes are syntax
*             translations from PSpice to native ngspice-42 (no ngbehavior=ps needed):
*               - PSpice VSWITCH  -> XSPICE aswitch with log=TRUE limit=TRUE (same Von/Voff/Ron/Roff;
*                 this is exactly the translation ngspice's own PSpice-compat mode performs)
*               - E/G "TABLE {x} ((x,y)...)" -> B-source pwl(x, ...) (same breakpoints, clamped ends)
*               - E "VALUE {IF(c,a,b)}" -> B-source "c ? a : b"; "&" -> "&&", "|" -> "||"
*               - RVAR POLY(2) multiplier -> B-source product (identical function)
*               - "TC=0,0" dropped (zero anyway); duplicate .MODEL PMOS01/DD and the duplicate
*                 SRLATCHRHP_BASIC_GEN definition removed; all sub-circuit and model names prefixed
*                 "lsw17_" so this file can share a deck with other circuits' models.
*             Pin order kept as TI's: CT GND ON QOD VIN VOUT.
*
* What the vendor model covers (TI usage note 1) and how it compares with SLVSDW8B
* (tests/test_load_switches.py::test_model_* re-measure these against the datasheet every run):
*   - Turn-on: CT pin = PMOS01 gate; gate pulled down by ITD ~3.3-4.5 uA (VIN table) until VSG = 0.5 V,
*     then IGATE ~0.8-1.1 uA; the external CT capacitor goes CT->VIN (datasheet pin table, Table 6-1).
*     -> tON / tR / SRON vs CT of Table 7.6 (tR 1.6 us/pF @3.6 V, 1.8 us/pF @5 V; tON 3.8 / 4 us/pF).
*   - RON vs VIN: PMOS01 (kp 9.75, vto -0.5) + RVAR 0.22-52 mOhm (VIN table) -> Table 7.5 RON 25 C.
*   - QOD: internal 144-195 Ohm (VIN table) switched to GND while disabled -> Table 7.5 "QOD 150 Ohm".
*   - ON pin: comparator, rising threshold 0.62-0.71 V (VIN table), hysteresis 30-70 mV (Figure 7-5);
*     smart pull-down RPD 750 kOhm connected while the comparator reads low (Table 7.5 RPD, Table 9-1);
*     10 nA sink while high (Table 7.5 ION).
*   - tOFF ~ 6 us internal delay (Table 7.6 tOFF 10 us); RCB comparator 0.2-0.64 A (VIN table, Table 7.5
*     IRCB -0.5 A typ) with 10 us delay (tRCB) and reverse leakage source (IIN,RCB).
*   - IQ 0.41-0.63 uA when on, ISD 2-9.6 nA when off (VIN tables, Figure 7-1/7-2).
*
* What is NOT modelled (vendor note 2 and own review):
*   - Temperature effects (vendor note 2).  The test file applies the datasheet RON max-vs-temperature rows
*     (Table 7.5) through the ADDED "ron_add" parameter below for the thermal / IR-drop corners only.
*   - Off-state leakage into VOUT: the vendor model returns ISD to GND, not to VOUT.  ADDED parameter
*     "isd_out" (A) injects a VIN->VOUT current while the switch is disabled, so a test can apply the
*     Table 7.5 ISD,VIN maximum (100 nA to 85 C, 250 nA to 105 C) as a worst-case floating-output leak.
*   - Reverse blocking while DISABLED: the body diode stays connected until the 0.5 A RCB comparator trips,
*     so small reverse currents with the switch off are not blocked as the "always-ON RCB" feature claims.
*     Only matters if VOUT > VIN; no test in this suite relies on off-state reverse blocking.
*   - Thermal shutdown / thermal model, ESD structures, package parasitics, CT capacitor voltage rating.
*   - Part-to-part spread: the datasheet gives only typical tR/tON/QOD/RPD values; corners vary the
*     external parts (netlist tolerances), VIN and the ADDED hooks only.
* ADDED (not in the TI netlist, default values leave the vendor behaviour unchanged):
*   ron_add  extra series resistance (Ohm) added to TI's RVAR U4 in the pass path, default 0
*   isd_out  worst-case off-state leakage VIN->VOUT (A), active only while the internal enable is low, default 0
* =====================================================================================================

.subckt LSW_TPS22917 CT GND ON QOD VIN VOUT params: ron_add=0 isd_out=0
* ---------------- quiescent / shutdown current (TI U2 block)
B_U2_G1         VIN GND I = pwl(V(U2_N14553232), 0,0, 1,408n, 1.8,550n, 3.6,479n, 5.5,633n)
R_U2_R3         U2_N14553152 U2_N14553136  10
C_U2_C3         0 U2_N14553232  1n
R_U2_R4         U2_N14553248 U2_N14553232  10
B_U2_ABM3       U2_N14553248 0 V = V(ON_INT_PRE) > 0.5 ? V(VIN) : 0
B_U2_ABM2       U2_N14553152 0 V = V(ON_INT_PRE) < 0.5 ? V(VIN) : 0
B_U2_G2         VIN GND I = pwl(V(U2_N14553136), 0,0, 1,2n, 1.8,2.62n, 3.6,3.53n, 5.5,9.55n)
C_U2_C2         0 U2_N14553136  1n
* ---------------- power stage, gate (CT) drive, QOD, reverse-current blocking (TI U1_U2 block)
I_U1_I1         U1_N15515882 GND DC 10n
X_U1_U2_H1      U1_U2_N16803039 U1_U2_N145001 U1_U2_I_REVERSE 0 lsw17_DRIVER_H1
M_U1_U2_M2      VOUT GATE U1_U2_N71809 U1_U2_N71809 lsw17_PMOS01
X_U1_U2_U15     U1_U2_N16806836 VOUT U1_U2_N1275293 U1_U2_VRCB lsw17_COMPHYS_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
R_U1_U2_R1      U1_U2_N16849773 0  1G
V_U1_U2_V5      U1_U2_N16806836 0 22m
B_U1_U2_E2      U1_U2_N16813178 0 V = pwl(V(VIN), 0,0, 1,195, 1.25,160, 1.5,155, 2,150, 3.5,145, 5,145, 5.5,144)
a_U1_U2_S3      %vd(U1_N03821 0) %gd(VIN CT) lsw17_S3
B_U1_U2_E8      U1_U2_N16851045 0 V = pwl(V(VIN), 1,254, 1.8,281, 3.6,333, 5.5,373)
X_U1_U2_U14     U1_U2_CTRL U1_U2_VRCB U1_U2_REVERSE_CTRL N129530 lsw17_SRLATCHRHP_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
D_U1_U2_D6      VOUT U1_U2_N71809 lsw17_DD
V_U1_U2_V4      U1_U2_N1275293 0 1n
X_U1_U2_F1      U1_U2_N16851045 U1_U2_N16849773 VOUT U1_U2_N16802853 lsw17_DRIVER_F1
X_U1_U2_U20     U1_U2_PRECTRL U1_U2_CTRL lsw17_BUF_DELAY_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5 DELAY=10u
a_U1_U2_S11     %vd(U1_U2_REVERSE_CTRL 0) %gd(U1_U2_N16803039 U1_U2_N16802853) lsw17_S11
B_U1_U2_E7      U1_U2_N15979 0 V = pwl(V(VIN), 1,197m, 1.8,381m, 3.6,534m, 5.5,641m)
X_U1_U2_U13     U1_U2_I_REVERSE U1_U2_N15979 U1_U2_N75775 U1_U2_PRECTRL lsw17_COMPHYS_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
* ADDED "+ {ron_add}": extra series resistance in TI's RVAR U4 (pass path only), default 0
B_U1_U2_E4      U1_U2_N16813658 0 V = pwl(V(VIN), 0,0, 1,0.22m, 1.8,30.35m, 5,51.94m) + {ron_add}
V_U1_U2_V2      U1_U2_N75775 0 1n
* ---------------- REPLACED BLOCK: turn-on slew control calibrated to SLVSDW8B Table 7.6 -------------------
* TI's gate drive (ITD/IGATE current into the PMOS gate = CT pin, Cgd 0.1n, Cgs 0.043n, D7 clamp) gives
* tR 0.58 ms / tON 0.89 ms at VIN 3.6 V, CT 1 nF, CL 1 uF, RL 10 Ohm, against Table 7.6 tR 1.6 ms / tON 3.8 ms
* (and 0.37 / 0.45 ms with CT open against 0.065 / 0.12 ms), so it is replaced by a CT ramp + VOUT tracker:
*  - CT pin: sinks I_ct = VIN / tON_k(VIN) while enabled, so the CT->VIN capacitor (CT + C_int) charges from 0 V
*    to VIN in exactly tON = tON_k * CT (Table 7.6 tON: 3.0/3.4/3.6/3.8/4.0 us/pF at VIN 1/1.2/1.8/3.6/5 V; Eq. 2).
*    TI's S3 still resets CT to VIN while disabled.  The pin ramps on to VIN + 0.3 V below VIN (CT pin about
*    -0.3 V) to finish the enhancement, then the current fades out linearly over the last 20 mV.
*  - VOUT reference: Vref = k*swing - Vdly with swing = V(VIN) - V(CT), k = Vtot/VIN, Vdly = Vtot - 0.9*VIN,
*    Vtot = tON_k * SRON_k (SRON_k = 1100/1000/1100/1900/2300 (mV/us)*pF, Table 7.6), so VOUT slews at
*    SRON_k / CT (Eq. 1) and crosses 90 % of VIN exactly at tON.  tR(10-90 %) = 0.8*VIN*CT/SRON_k
*    (1.58 ms @3.6 V, 1.79 ms @5 V for 1 nF, Table 7.6 1.6 / 1.8 us/pF).
*  - Gate: VSG = Vt + A*(Vref - VOUT) (A = 20, clamped 0..VIN), plus a hand-over term that drives VSG to VIN as
*    the CT swing goes from VIN to VIN + 0.3 V, through a 5 ns gate filter.  TI's PMOS01 / RVAR / body diode /
*    RCB switch S10 remain the power path, so RON, QOD, IQ/ISD and RCB are the vendor's.
*  - C_int = 33 pF (CT->VIN): Table 7.6 CT-open tON 120 us @3.6 V / 100 us @5 V = tON_k * C_int.
B_SL_ICT        CT GND I = V(U1_N03821) > 0.5 ? V(VIN)/V(SL_TONK) * min(1, max(0, (V(SL_SWEND)-V(VIN)+V(CT))/0.02)) : 0
C_SL_INT        CT VIN 33p
B_SL_TONK       SL_TONK 0 V = pwl(V(VIN), 0,3e6, 1,3e6, 1.2,3.4e6, 1.8,3.6e6, 3.6,3.8e6, 5,4e6, 5.5,4e6)
B_SL_SRK        SL_SRK 0 V = pwl(V(VIN), 0,1.1e-6, 1,1.1e-6, 1.2,1.0e-6, 1.8,1.1e-6, 3.6,1.9e-6, 5,2.3e-6, 5.5,2.3e-6)
B_SL_VTOT       SL_VTOT 0 V = V(SL_TONK) * V(SL_SRK)
B_SL_SWEND      SL_SWEND 0 V = V(VIN) + 0.3
B_SL_VREF       SL_VREF 0 V = (V(VIN) > 0.2 ? V(SL_VTOT)/V(VIN) : 0) * (V(VIN)-V(CT)) - (V(SL_VTOT) - 0.9*V(VIN))
B_SL_VSG        SL_VSG 0 V = V(U1_N03821) > 0.5 ?
+                 min(V(VIN), max(0, max(0.5 + 20*(V(SL_VREF) - V(VOUT)),
+                 0.5 + (V(VIN)-0.5) * min(1, max(0, (V(VIN)-V(CT)-V(VIN))/0.3))))) : 0
B_SL_GDRV       SL_GDRV 0 V = V(VIN) - V(SL_VSG)
R_SL_G          SL_GDRV GATE 50
C_SL_G          GATE U1_U2_N71809 100p
X_U1_U2_U1      QOD U1_U2_N16813094 U1_U2_N16813178 0 lsw17_RVAR params: RREF=1
a_U1_U2_S4      %vd(U1_N03821 0) %gd(U1_U2_N16813094 GND) lsw17_S4
a_U1_U2_S10     %vd(U1_U2_REVERSE_CTRL 0) %gd(U1_U2_N16803039 U1_U2_N71809) lsw17_S10
X_U1_U2_U4      VIN U1_U2_N145001 U1_U2_N16813658 0 lsw17_RVAR params: RREF=1
* ADDED isd_out: off-state leakage VIN->VOUT while the internal enable (U1_N03821) is low
B_ADD_ISD       VIN VOUT I = V(U1_N03821) < 0.5 ? {isd_out} : 0
* ---------------- ON pin: threshold comparator, smart pull-down, enable delay (TI U1 / U1_U1 blocks)
a_U1_S5         %vd(ON_INT_PRE GND) %gd(ON U1_N15515882) lsw17_S5
B_U1_U1_E2      U1_U1_HYS 0 V = pwl(V(VIN), 0,0, 1,0.07, 1.8,0.07, 3.5,0.05, 5.5,0.03)
B_U1_U1_ABM2I4  U1_U1_N14507001 U1_U1_ON_A I = V(ON_INT_PRE) > 0.5 ? 1m : 0
C_U1_U1_C1      0 U1_U1_ON_A  1n IC=0
V_U1_U1_V5      U1_U1_N14507001 0 2
C_U1_U1_C4      U1_U1_N15516099 0  1n
R_U1_U1_R3      U1_U1_N15516119 U1_U1_N15516099  10
V_U1_U1_V4      U1_U1_N427908 0 1
a_U1_U1_S2      %vd(U1_U1_N427944 0) %gd(U1_U1_N427908 U1_U1_ON_A) lsw17_S2
D_U1_U1_D3      U1_U1_ON_A U1_U1_N14507001 lsw17_DD
B_U1_U1_ABM5    U1_U1_N15516119 0 V = V(ON_INT_PRE) < 0.5 ? V(VIN) : 0
B_U1_U1_E1      U1_U1_THRISE 0 V = pwl(V(VIN), 0,0, 1,0.62, 1.8,0.62, 3.5,0.66, 5.5,0.71)
X_U1_U1_U5      ON U1_U1_THRISE U1_U1_HYS ON_INT_PRE lsw17_COMPHYS_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
X_U1_U1_U46     U1_N03821 ON_INT_PRE U1_U1_N427964 lsw17_NOR2_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=500E-3
X_U1_U1_U43     U1_U1_ON_A U1_N03821 lsw17_BUF_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
B_U1_U1_G1      U1_U1_ON_A 0 I = pwl(V(U1_U1_N15516099), 0,0, 1,20u, 1.2,25u, 1.8,48u, 3,70u, 3.6,90u, 5,120u)
X_U1_U1_U44     ON_INT_PRE U1_N03821 U1_U1_N427944 lsw17_AND2_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=500E-3
a_U1_U1_S1      %vd(U1_U1_N427964 0) %gd(U1_U1_ON_A 0) lsw17_S1
a_U1_S4         %vd(ON_INT_PRE GND) %gd(ON GND) lsw17_S4ON
* ---------------- switch models (TI DRIVER_*/CONTROL_*/CHANNEL_* VSWITCH -> aswitch, same values)
.model lsw17_S3   aswitch(cntl_off=0.8 cntl_on=0.2 r_off=1e9   r_on=1    log=TRUE limit=TRUE)
.model lsw17_S11  aswitch(cntl_off=0   cntl_on=1   r_off=1e9   r_on=0.1  log=TRUE limit=TRUE)
.model lsw17_S4   aswitch(cntl_off=0.9 cntl_on=0.1 r_off=1e9   r_on=1m   log=TRUE limit=TRUE)
.model lsw17_S10  aswitch(cntl_off=1   cntl_on=0   r_off=1e9   r_on=0.1m log=TRUE limit=TRUE)
.model lsw17_S5   aswitch(cntl_off=0.1 cntl_on=0.8 r_off=1e9   r_on=1    log=TRUE limit=TRUE)
.model lsw17_S2   aswitch(cntl_off=0.2 cntl_on=0.8 r_off=100e6 r_on=1m   log=TRUE limit=TRUE)
.model lsw17_S1   aswitch(cntl_off=0.2 cntl_on=0.8 r_off=100e6 r_on=1m   log=TRUE limit=TRUE)
.model lsw17_S4ON aswitch(cntl_off=0.8 cntl_on=0.1 r_off=1e9   r_on=750k log=TRUE limit=TRUE)
.ends LSW_TPS22917

.subckt lsw17_DRIVER_H1 1 2 3 4
H_U1_U2_H1      3 4 VH_U1_U2_H1 1
VH_U1_U2_H1     1 2 0V
.ends lsw17_DRIVER_H1

.subckt lsw17_DRIVER_F1 1 2 3 4
F_U1_U2_F1      3 4 VF_U1_U2_F1 1
VF_U1_U2_F1     1 2 0V
.ends lsw17_DRIVER_F1

.model lsw17_PMOS01 pmos (level=1 vto=-0.5 kp=9.75 lambda=0.001)
.model lsw17_DD d (is=1e-15 n=0.01 tt=1e-11)

.subckt lsw17_SRLATCHRHP_BASIC_GEN s r q qb params: vdd=1 vss=0 vthresh=0.5
* reset has priority
bq 0 qint I = v(r) > {vthresh} ? -5 : (v(s) > {vthresh} ? 5 : 0)
cqint qint 0 1n
rqint qint 0 1000meg
d_d10 qint my5 lsw17_d_d1
v1 my5 0 {vdd}
d_d11 myvss qint lsw17_d_d1
v2 myvss 0 {vss}
eq qqq 0 qint 0 1
x3 qqq qqqd1 lsw17_BUF_BASIC_GEN params: vdd={vdd} vss={vss} vthresh={vthresh}
rqq qqqd1 q 1
bqb qbr 0 v = v(q) > {vthresh} ? {vss} : {vdd}
rqb qbr qb 1
cdummy1 q 0 1n
cdummy2 qb 0 1n
.ic v(qint)={vss}
.model lsw17_d_d1 d (is=1e-15 tt=1e-11 rs=0.05 n=0.1)
.ends lsw17_SRLATCHRHP_BASIC_GEN

.subckt lsw17_COMPHYS_BASIC_GEN INP INM HYS OUT params: VDD=1 VSS=0 VTHRESH=0.5
EIN INP1 INM1 INP INM 1
BHYS INP1 INP2 V = V(1) > {VTHRESH} ? -V(HYS) : 0
BOUT OUT 0 V = V(INP2) > V(INM1) ? {VDD} : {VSS}
R1 OUT 1 1
C1 1 0 5n
RINP1 INP1 0 1K
.ends lsw17_COMPHYS_BASIC_GEN

.subckt lsw17_AND2_BASIC_GEN A B Y params: VDD=1 VSS=0 VTHRESH=0.5
BGATE YINT 0 V = (V(A) > {VTHRESH} && V(B) > {VTHRESH}) ? {VDD} : {VSS}
RINT YINT Y 1
CINT Y 0 1n
.ends lsw17_AND2_BASIC_GEN

.subckt lsw17_NOR2_BASIC_GEN A B Y params: VDD=1 VSS=0 VTHRESH=0.5
BGATE YINT 0 V = (V(A) > {VTHRESH} || V(B) > {VTHRESH}) ? {VSS} : {VDD}
RINT YINT Y 1
CINT Y 0 1n
.ends lsw17_NOR2_BASIC_GEN

.subckt lsw17_BUF_BASIC_GEN A Y params: VDD=1 VSS=0 VTHRESH=0.5
BGATE YINT 0 V = V(A) > {VTHRESH} ? {VDD} : {VSS}
RINT YINT Y 1
CINT Y 0 1n
.ends lsw17_BUF_BASIC_GEN

.subckt lsw17_BUF_DELAY_BASIC_GEN A Y params: VDD=1 VSS=0 VTHRESH=0.5 DELAY=10n
BGATE1 YINT1 0 V = V(A) > {VTHRESH} ? {VDD} : {VSS}
RINT YINT1 YINT2 1
CINT YINT2 0 {DELAY*1.3}
BGATE2 YINT3 0 V = V(YINT2) > {VTHRESH} ? {VDD} : {VSS}
RINT2 YINT3 Y 1
CINT2 Y 0 1n
.ends lsw17_BUF_DELAY_BASIC_GEN

.subckt lsw17_RVAR 101 102 201 202 params: RREF=1
* resistance between 101 and 102 equal to V(201,202) (TI RVAR: rin, r, fcopy, eout POLY(2), vsense)
rin 201 202 1G
r 301 0 {RREF}
fcopy 0 301 vsense 1
beout 101 106 V = V(201,202) * V(301)
vsense 106 102 0
.ends lsw17_RVAR
