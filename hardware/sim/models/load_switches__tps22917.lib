* =====================================================================================================
* load_switches__tps22917.lib  --  TI TPS22917 1-5.5 V, 2 A, 80 mOhm load switch (U2 LED rail, U21 OLED boost)
* =====================================================================================================
* Part      : Texas Instruments TPS22917DBVR (SOT-23-6, active-high ON), LCSC C2681320
* Datasheet : https://www.ti.com/lit/ds/symlink/tps22917.pdf  SLVSDW8B (Sept 2017, revised Dec 2021)
* Base      : TI "TPS22917 Unencrypted PSpice Transient Model", SLVMCE8 (https://www.ti.com/lit/zip/SLVMCE8),
*             TPS22917_TRANS.LIB "Final 1.00" 14DEC2017 (the SLVMCE9A package carries the identical netlist).
*             Pin order kept as TI's: CT GND ON QOD VIN VOUT.
*
* (1) Syntax translation PSpice -> native ngspice-42 (no ngbehavior=ps):
*     VSWITCH -> XSPICE aswitch log=TRUE limit=TRUE (same Von/Voff/Ron/Roff); E/G TABLE -> B-source pwl()
*     (same breakpoints); E VALUE IF() -> B-source; RVAR POLY(2) -> B-source product; TC=0,0 dropped; duplicate
*     .MODEL PMOS01 / DD and SRLATCHRHP definitions removed; all names prefixed lsw17_.
*     Every ideal logic step (gates, latch, comparators, enables) is written as 0.5*(1+tanh(x/w)), w = 50 mV
*     on the 0/1 V logic nodes and 1 mV on comparator inputs (same thresholds/levels; ngspice otherwise stalls
*     with "timestep too small" at switching events that PSpice steps over).  The ideal N = 0.01 / 0.1 logic
*     diodes get xti=0 eg=0 (their IS(T) scaling overflows away from TNOM).
* (2) REPLACED: the turn-on (slew) block.  Measured in ngspice with the TI netlist in the datasheet test circuit
*     (CT 1 nF to VIN, CL 1 uF, RL 10 Ohm): tR 0.58 ms / tON 0.89 ms at VIN 3.6 V against Table 7.6 1.6 / 3.8 ms,
*     and 0.37 / 0.45 ms with CT open against 0.065 / 0.12 ms (load-limited ramp of a PMOS whose gate IS the CT
*     pin).  The CT ramp, VOUT reference and pass element below reproduce Table 7.6 (details at the block).
*     test_model_turn_on_matches_table_7_6 checks tR, tON and SRON at 3.6 V and 5 V every run.
* (3) FIXED vendor artifact: TI's F1 sank its IIN,RCB leakage (~0.3 uA) out of VOUT permanently; it is now
*     gated by the RCB latch, as Table 7.5 specifies IIN,RCB only for VOUT > VIN.
* (4) ADDED parameters (defaults leave the behaviour unchanged):
*     ron_add  extra pass resistance (Ohm) added to TI's RVAR U4: the tests use it to apply the Table 7.5 RON
*              max-vs-temperature rows (temperature is not modelled, vendor note 2).
*     isd_out  VIN -> VOUT leakage (A) while disabled: the tests apply the Table 7.5 ISD,VIN maximum (100 nA to
*              85 C) as a worst-case leak into a floating output (TI returns ISD to GND only).
*
* Kept from TI and checked against SLVSDW8B (tests/test_load_switches.py::test_model_*):
*   RON vs VIN: full-on channel 1/(9.75 (VIN-0.5)) + RVAR 0.22-52 mOhm table -> 77 mOhm @3.6 V, 76 @5 V
*     (Table 7.5: 90 typ / 110 max and 80 typ / 100 max at 25 C).
*   QOD: 144-195 Ohm (VIN table) switched to GND while disabled -> 145 Ohm (Table 7.5 "QOD 150 Ohm").
*   ON pin: comparator rising 0.62-0.71 V (VIN table), hysteresis 30-70 mV (Figure 7-5), inside the
*     guaranteed VIL max 0.35 / VIH min 1.0 V (Table 7.3); smart pull-down 750 kOhm while the comparator reads
*     low, 10 nA sink while high (Table 7.5 RPD, ION; Table 9-1).
*   tOFF: ~6 us internal delay (Table 7.6 tOFF 10 us typ).  RCB: 0.2-0.64 A comparator (Table 7.5 IRCB -0.5 A typ),
*     10 us delay (tRCB).  IQ 0.41-0.63 uA on, ISD 2-9.6 nA off (VIN tables, Figures 7-1 / 7-2).
*
* NOT modelled: temperature (vendor note 2; see ron_add / isd_out); reverse blocking while DISABLED (the body
*   diode stays connected until the 0.5 A RCB comparator trips; only matters if VOUT > VIN, which no test here
*   relies on); thermal shutdown / thermal model; ESD structures; package parasitics; CT capacitor voltage rating;
*   part-to-part spread (the datasheet gives typical tR/tON/QOD/RPD only).  The CT-open turn-on is only
*   approximate (C_int fitted to tON: tR comes out about 25 % fast); the CT-to-VIN vs CT-to-GND difference during
*   VIN hot-plug is not represented (S3 holds CT at VIN while disabled).
* =====================================================================================================

.subckt LSW_TPS22917 CT GND ON QOD VIN VOUT params: ron_add=0 isd_out=0
* ---------------- quiescent / shutdown current (TI U2 block)
B_U2_G1         VIN GND I = pwl(V(U2_N14553232), 0,0, 1,408n, 1.8,550n, 3.6,479n, 5.5,633n)
R_U2_R3         U2_N14553152 U2_N14553136  10
C_U2_C3         0 U2_N14553232  1n
R_U2_R4         U2_N14553248 U2_N14553232  10
B_U2_ABM3       U2_N14553248 0 V = V(VIN)*(0.5+0.5*tanh((V(ON_INT_PRE)-0.5)/0.05))
B_U2_ABM2       U2_N14553152 0 V = V(VIN)*(0.5+0.5*tanh((0.5-V(ON_INT_PRE))/0.05))
B_U2_G2         VIN GND I = pwl(V(U2_N14553136), 0,0, 1,2n, 1.8,2.62n, 3.6,3.53n, 5.5,9.55n)
C_U2_C2         0 U2_N14553136  1n
* ---------------- power stage, gate (CT) drive, QOD, reverse-current blocking (TI U1_U2 block)
I_U1_I1         U1_N15515882 GND DC 10n
X_U1_U2_H1      U1_U2_N16803039 U1_U2_N145001 U1_U2_I_REVERSE 0 lsw17_DRIVER_H1
X_U1_U2_U15     U1_U2_N16806836 VOUT U1_U2_N1275293 U1_U2_VRCB lsw17_COMPHYS_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
V_U1_U2_V5      U1_U2_N16806836 0 22m
B_U1_U2_E2      U1_U2_N16813178 0 V = pwl(V(VIN), 0,0, 1,195, 1.25,160, 1.5,155, 2,150, 3.5,145, 5,145, 5.5,144)
a_U1_U2_S3      %vd(U1_N03821 0) %gd(VIN CT) lsw17_S3
B_U1_U2_E8      U1_U2_N16851045 0 V = pwl(V(VIN), 1,254, 1.8,281, 3.6,333, 5.5,373)
X_U1_U2_U14     U1_U2_CTRL U1_U2_VRCB U1_U2_REVERSE_CTRL N129530 lsw17_SRLATCHRHP_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
D_U1_U2_D6      VOUT U1_U2_N71809 lsw17_DD
V_U1_U2_V4      U1_U2_N1275293 0 1n
* FIXED vendor artifact: TI's F1 drew its IIN,RCB leakage (E8 table / 1 GOhm, 254-373 nA) out of VOUT at all
* times, into a node that only connects through S11 (1 GOhm while not blocking), i.e. a permanent ~0.3 uA sink on
* VOUT.  Table 7.5 specifies IIN,RCB only for VOUT > VIN (blocking), so the same current is now gated by the RCB
* latch output.
B_U1_U2_F1      VOUT U1_U2_N16802853 I = V(U1_U2_N16851045)/1G * V(U1_U2_REVERSE_CTRL)
X_U1_U2_U20     U1_U2_PRECTRL U1_U2_CTRL lsw17_BUF_DELAY_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5 DELAY=10u
a_U1_U2_S11     %vd(U1_U2_REVERSE_CTRL 0) %gd(U1_U2_N16803039 U1_U2_N16802853) lsw17_S11
B_U1_U2_E7      U1_U2_N15979 0 V = pwl(V(VIN), 1,197m, 1.8,381m, 3.6,534m, 5.5,641m)
X_U1_U2_U13     U1_U2_I_REVERSE U1_U2_N15979 U1_U2_N75775 U1_U2_PRECTRL lsw17_COMPHYS_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
* ADDED "+ {ron_add}": extra series resistance in TI's RVAR U4 (pass path only), default 0
B_U1_U2_E4      U1_U2_N16813658 0 V = pwl(V(VIN), 0,0, 1,0.22m, 1.8,30.35m, 5,51.94m) + {ron_add}
V_U1_U2_V2      U1_U2_N75775 0 1n
* ---------------- REPLACED BLOCK: turn-on slew control calibrated to SLVSDW8B Table 7.6 -------------------
* TI's gate drive (ITD/IGATE current into the PMOS gate = CT pin, Cgd 0.1n, Cgs 0.043n, D7 clamp) gives
* tR 0.58 ms / tON 0.89 ms at VIN 3.6 V, CT 1 nF, CL 1 uF, RL 10 Ohm, against Table 7.6 tR 1.6 ms / tON 3.8 ms
* (and 0.37 / 0.45 ms with CT open against 0.065 / 0.12 ms), so it is replaced by a CT ramp + VOUT tracker:
*  - CT pin: sinks I_ct = VIN / tON_k(VIN) while enabled, so the CT->VIN capacitor (CT + C_int) charges from 0 V
*    to VIN in exactly tON = tON_k * CT (Table 7.6 tON: 3.0/3.4/3.6/3.8/4.0 us/pF at VIN 1/1.2/1.8/3.6/5 V; Eq. 2).
*    TI's S3 still resets CT to VIN while disabled.  The pin ramps on to VIN + 0.5 V below VIN (CT pin about
*    -0.5 V) so the reference passes VIN (full enhancement), then the current fades out over the last 20 mV.
*  - VOUT reference: Vref = k*swing - Vdly with swing = V(VIN) - V(CT), k = Vtot/VIN, Vdly = Vtot - 0.9*VIN,
*    Vtot = tON_k * SRON_k (SRON_k = 1100/1000/1100/1900/2300 (mV/us)*pF, Table 7.6), so VOUT slews at
*    SRON_k / CT (Eq. 1) and crosses 90 % of VIN exactly at tON.  tR(10-90 %) = 0.8*VIN*CT/SRON_k
*    (1.58 ms @3.6 V, 1.79 ms @5 V for 1 nF, Table 7.6 1.6 / 1.8 us/pF).
*  - Pass element (replaces TI's PMOS01 M2, gate = CT): a forward current source that holds VOUT on Vref behind
*    PMOS01's full-on channel resistance 1/(kp*(VIN-0.5)); once Vref passes VIN it is that resistance in both
*    directions.  TI's RVAR (pass-resistance table), current sense H1, RCB switch S10 and body diode D6 stay in
*    the path, so RON, RCB, QOD, IQ/ISD and the ON-pin logic remain the vendor's.  (A first version drove a
*    PMOS gate from an error amplifier; it was numerically stiff, so the loop was removed.)
*  - C_int = 33 pF (CT->VIN): Table 7.6 CT-open tON 120 us @3.6 V / 100 us @5 V = tON_k * C_int.
B_SL_ICT        CT GND I = (0.5+0.5*tanh((V(U1_N03821)-0.5)/0.05)) * min(max(V(VIN),0),10)/V(SL_TONK) * min(1, max(0, (V(SL_SWEND)-V(VIN)+V(CT))/0.02))
C_SL_INT        CT VIN 33p
B_SL_TONK       SL_TONK 0 V = pwl(V(VIN), 0,3e6, 1,3e6, 1.2,3.4e6, 1.8,3.6e6, 3.6,3.8e6, 5,4e6, 5.5,4e6)
B_SL_SRK        SL_SRK 0 V = pwl(V(VIN), 0,1.1e-6, 1,1.1e-6, 1.2,1.0e-6, 1.8,1.1e-6, 3.6,1.9e-6, 5,2.3e-6, 5.5,2.3e-6)
B_SL_VTOT       SL_VTOT 0 V = V(SL_TONK) * V(SL_SRK)
B_SL_SWEND      SL_SWEND 0 V = V(VIN) + 0.5
B_SL_VRAW       SL_VRAW 0 V = V(SL_VTOT)/min(max(V(VIN), 0.5), 10) * (V(VIN)-V(CT)) - (V(SL_VTOT) - 0.9*V(VIN))
* soft start of the ramp (softplus, 50 mV knee, about 30 us at 1.9 V/ms): the real slew starts smoothly and a
* hard corner only produces a numerical current spike in the output capacitance
B_SL_VREF       SL_VREF 0 V = V(SL_VRAW) > 1 ? V(SL_VRAW) : 0.05*ln(1 + exp(min(V(SL_VRAW)/0.05, 40)))
* pass element: forward current that makes VOUT follow Vref behind the full-on channel resistance of TI's
* PMOS01 (1/(kp*(VIN - |vto|)), kp 9.75, vto -0.5); fully on (k_full = 1) once Vref passes VIN, where it is a
* plain bidirectional resistor.  It sits where TI's PMOS sat (source node after S10 -> VOUT), so TI's RVAR
* (pass resistance table), current sense H1 and the RCB switch S10 stay in series with it.
B_SL_KF         SL_KF 0 V = min(1, max(0, (V(SL_VREF) - V(VIN))/0.05))
B_SL_RCH        SL_RCH 0 V = 1/(9.75*min(max(V(VIN) - 0.5, 0.05), 10))
B_SL_PASS       U1_U2_N71809 VOUT I = (0.5+0.5*tanh((V(U1_N03821)-0.5)/0.05)) * (V(SL_KF)*(V(U1_U2_N71809) - V(VOUT)) +
+                 (1 - V(SL_KF))*max(0, min(V(SL_VREF), V(U1_U2_N71809)) - V(VOUT))) / V(SL_RCH)
X_U1_U2_U1      QOD U1_U2_N16813094 U1_U2_N16813178 0 lsw17_RVAR params: RREF=1
a_U1_U2_S4      %vd(U1_N03821 0) %gd(U1_U2_N16813094 GND) lsw17_S4
a_U1_U2_S10     %vd(U1_U2_REVERSE_CTRL 0) %gd(U1_U2_N16803039 U1_U2_N71809) lsw17_S10
X_U1_U2_U4      VIN U1_U2_N145001 U1_U2_N16813658 0 lsw17_RVAR params: RREF=1
* ADDED isd_out: off-state leakage VIN->VOUT while the internal enable (U1_N03821) is low
B_ADD_ISD       VIN VOUT I = {isd_out}*(0.5+0.5*tanh((0.5-V(U1_N03821))/0.05))
* ---------------- ON pin: threshold comparator, smart pull-down, enable delay (TI U1 / U1_U1 blocks)
a_U1_S5         %vd(ON_INT_PRE GND) %gd(ON U1_N15515882) lsw17_S5
B_U1_U1_E2      U1_U1_HYS 0 V = pwl(V(VIN), 0,0, 1,0.07, 1.8,0.07, 3.5,0.05, 5.5,0.03)
B_U1_U1_ABM2I4  U1_U1_N14507001 U1_U1_ON_A I = 1m*(0.5+0.5*tanh((V(ON_INT_PRE)-0.5)/0.05))
C_U1_U1_C1      0 U1_U1_ON_A  1n IC=0
V_U1_U1_V5      U1_U1_N14507001 0 2
C_U1_U1_C4      U1_U1_N15516099 0  1n
R_U1_U1_R3      U1_U1_N15516119 U1_U1_N15516099  10
V_U1_U1_V4      U1_U1_N427908 0 1
a_U1_U1_S2      %vd(U1_U1_N427944 0) %gd(U1_U1_N427908 U1_U1_ON_A) lsw17_S2
D_U1_U1_D3      U1_U1_ON_A U1_U1_N14507001 lsw17_DD
B_U1_U1_ABM5    U1_U1_N15516119 0 V = V(VIN)*(0.5+0.5*tanh((0.5-V(ON_INT_PRE))/0.05))
B_U1_U1_E1      U1_U1_THRISE 0 V = pwl(V(VIN), 0,0, 1,0.62, 1.8,0.62, 3.5,0.66, 5.5,0.71)
X_U1_U1_U5      ON U1_U1_THRISE U1_U1_HYS ON_INT_PRE lsw17_COMPHYS_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
X_U1_U1_U46     U1_N03821 ON_INT_PRE U1_U1_N427964 lsw17_NOR2_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=500E-3
X_U1_U1_U43     U1_U1_ON_A U1_N03821 lsw17_BUF_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=0.5
B_U1_U1_G1      U1_U1_ON_A 0 I = pwl(V(U1_U1_N15516099), 0,0, 1,20u, 1.2,25u, 1.8,48u, 3,70u, 3.6,90u, 5,120u)
X_U1_U1_U44     ON_INT_PRE U1_N03821 U1_U1_N427944 lsw17_AND2_BASIC_GEN params: VDD=1 VSS=0 VTHRESH=500E-3
a_U1_U1_S1      %vd(U1_U1_N427964 0) %gd(U1_U1_ON_A 0) lsw17_S1
a_U1_S4         %vd(ON_INT_PRE GND) %gd(ON GND) lsw17_S4ON
* ---------------- switch models (TI DRIVER_*/CONTROL_*/CHANNEL_* VSWITCH -> aswitch, same values)
.model lsw17_S3   aswitch(cntl_off=0.8 cntl_on=0.2 r_off=1e9   r_on=1    log=TRUE limit=TRUE)
.model lsw17_S11  aswitch(cntl_off=0   cntl_on=1   r_off=1e9   r_on=0.1  log=TRUE limit=TRUE)
.model lsw17_S4   aswitch(cntl_off=0.9 cntl_on=0.1 r_off=1e9   r_on=1m   log=TRUE limit=TRUE)
.model lsw17_S10  aswitch(cntl_off=1   cntl_on=0   r_off=1e9   r_on=0.1m log=TRUE limit=TRUE)
.model lsw17_S5   aswitch(cntl_off=0.1 cntl_on=0.8 r_off=1e9   r_on=1    log=TRUE limit=TRUE)
.model lsw17_S2   aswitch(cntl_off=0.2 cntl_on=0.8 r_off=100e6 r_on=1m   log=TRUE limit=TRUE)
.model lsw17_S1   aswitch(cntl_off=0.2 cntl_on=0.8 r_off=100e6 r_on=1m   log=TRUE limit=TRUE)
.model lsw17_S4ON aswitch(cntl_off=0.8 cntl_on=0.1 r_off=1e9   r_on=750k log=TRUE limit=TRUE)
.ends LSW_TPS22917

.subckt lsw17_DRIVER_H1 1 2 3 4
H_U1_U2_H1      3 4 VH_U1_U2_H1 1
VH_U1_U2_H1     1 2 0V
.ends lsw17_DRIVER_H1

.subckt lsw17_DRIVER_F1 1 2 3 4
F_U1_U2_F1      3 4 VF_U1_U2_F1 1
VF_U1_U2_F1     1 2 0V
.ends lsw17_DRIVER_F1

.model lsw17_PMOS01 pmos (level=1 vto=-0.5 kp=9.75 lambda=0.001)
* xti=0 eg=0 (ADDED): these ideal N=0.01/0.1 diodes are logic/clamp elements; ngspice's IS(T) scaling
* (T/Tnom)^(XTI/N) * exp(EG/(N k)...) would overflow at any temperature other than TNOM
.model lsw17_DD d (is=1e-15 n=0.01 tt=1e-11 xti=0 eg=0)

.subckt lsw17_SRLATCHRHP_BASIC_GEN s r q qb params: vdd=1 vss=0 vthresh=0.5
* reset has priority
bq 0 qint I = -5*(0.5+0.5*tanh((v(r)-{vthresh})/0.05)) + 5*(0.5+0.5*tanh((v(s)-{vthresh})/0.05))*(1-(0.5+0.5*tanh((v(r)-{vthresh})/0.05)))
cqint qint 0 1n
rqint qint 0 1000meg
d_d10 qint my5 lsw17_d_d1
v1 my5 0 {vdd}
d_d11 myvss qint lsw17_d_d1
v2 myvss 0 {vss}
eq qqq 0 qint 0 1
x3 qqq qqqd1 lsw17_BUF_BASIC_GEN params: vdd={vdd} vss={vss} vthresh={vthresh}
rqq qqqd1 q 1
bqb qbr 0 v = {vdd} + ({vss}-{vdd})*(0.5+0.5*tanh((v(q)-{vthresh})/0.05))
rqb qbr qb 1
cdummy1 q 0 1n
cdummy2 qb 0 1n
.ic v(qint)={vss}
.model lsw17_d_d1 d (is=1e-15 tt=1e-11 rs=0.05 n=0.1 xti=0 eg=0)
.ends lsw17_SRLATCHRHP_BASIC_GEN

.subckt lsw17_COMPHYS_BASIC_GEN INP INM HYS OUT params: VDD=1 VSS=0 VTHRESH=0.5
EIN INP1 INM1 INP INM 1
BHYS INP1 INP2 V = -V(HYS)*(0.5+0.5*tanh((V(1)-{VTHRESH})/0.05))
BOUT OUT 0 V = {VSS} + ({VDD}-{VSS})*(0.5+0.5*tanh((V(INP2)-V(INM1))/1m))
R1 OUT 1 1
C1 1 0 5n
RINP1 INP1 0 1K
.ends lsw17_COMPHYS_BASIC_GEN

.subckt lsw17_AND2_BASIC_GEN A B Y params: VDD=1 VSS=0 VTHRESH=0.5
BGATE YINT 0 V = {VSS} + ({VDD}-{VSS})*(0.5+0.5*tanh((V(A)-{VTHRESH})/0.05))*(0.5+0.5*tanh((V(B)-{VTHRESH})/0.05))
RINT YINT Y 1
CINT Y 0 1n
.ends lsw17_AND2_BASIC_GEN

.subckt lsw17_NOR2_BASIC_GEN A B Y params: VDD=1 VSS=0 VTHRESH=0.5
BGATE YINT 0 V = {VSS} + ({VDD}-{VSS})*(1-(0.5+0.5*tanh((V(A)-{VTHRESH})/0.05)))*(1-(0.5+0.5*tanh((V(B)-{VTHRESH})/0.05)))
RINT YINT Y 1
CINT Y 0 1n
.ends lsw17_NOR2_BASIC_GEN

.subckt lsw17_BUF_BASIC_GEN A Y params: VDD=1 VSS=0 VTHRESH=0.5
BGATE YINT 0 V = {VSS} + ({VDD}-{VSS})*(0.5+0.5*tanh((V(A)-{VTHRESH})/0.05))
RINT YINT Y 1
CINT Y 0 1n
.ends lsw17_BUF_BASIC_GEN

.subckt lsw17_BUF_DELAY_BASIC_GEN A Y params: VDD=1 VSS=0 VTHRESH=0.5 DELAY=10n
BGATE1 YINT1 0 V = {VSS} + ({VDD}-{VSS})*(0.5+0.5*tanh((V(A)-{VTHRESH})/0.05))
RINT YINT1 YINT2 1
CINT YINT2 0 {DELAY*1.3}
BGATE2 YINT3 0 V = {VSS} + ({VDD}-{VSS})*(0.5+0.5*tanh((V(YINT2)-{VTHRESH})/0.05))
RINT2 YINT3 Y 1
CINT2 Y 0 1n
.ends lsw17_BUF_DELAY_BASIC_GEN

.subckt lsw17_RVAR 101 102 201 202 params: RREF=1
* resistance between 101 and 102 equal to V(201,202) (TI RVAR: rin, r, fcopy, eout POLY(2), vsense)
rin 201 202 1G
r 301 0 {RREF}
fcopy 0 301 vsense 1
beout 101 106 V = V(201,202) * V(301)
vsense 106 102 0
.ends lsw17_RVAR
